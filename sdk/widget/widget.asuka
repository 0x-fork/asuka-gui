// Package platform/widget sets what the app's widgets show: iOS's WidgetKit
// widgets (an extension the CLI adds for asuka.toml's widgets, drawn from
// Entry), Android's App Widgets. A kind is one of asuka.toml's widgets;
// its entries show in turn, each from its time. The desktops and the web
// have no widgets: set does nothing there.
//
//   widget.set("energy", widget.Entry(title: "Energy", value: "72%", progress: 0.72, showProgress: true))

import platform/host
import std/json
import std/time

/// What a widget shows.
pub struct Entry {
  title: string = ""
  /// The big value.
  value: string = ""
  body: string = ""
  /// A small line at the bottom.
  caption: string = ""
  /// An SF Symbol's name.
  symbol: string = ""
  /// From 0 to 1, shown with showProgress.
  progress: float = 0.0
  showProgress: bool = false
  /// A count down to this time (none: no count down).
  until: time.Time? = none
  /// "#rrggbb" or "#rrggbbaa".
  tint: string = ""
  /// What the app is opened with when the widget is tapped.
  url: string = ""
  /// When it shows (none: now).
  at: time.Time? = none
}

struct Wire {
  title: string
  value: string
  body: string
  caption: string
  symbol: string
  progress: float
  showProgress: bool
  untilMs: int
  atMs: int
  tint: string
  url: string
}

struct Set {
  kind: string
  entries: [Wire]
}

/// Sets what the kind of widget shows: e now.
pub fn set(kind: string, e: Entry) = setAll(kind, [e])

/// Sets the kind's entries, each from its time.
pub fn setAll(kind: string, entries: [Entry]) {
  let es = entries.sorted((a, b) => (a.at?.unixMilli() ?? 0) < (b.at?.unixMilli() ?? 0)).map(e => Wire(title: e.title, value: e.value, body: e.body, caption: e.caption,
    symbol: e.symbol, progress: e.progress, showProgress: e.showProgress, untilMs: e.until?.unixMilli() ?? 0, atMs: e.at?.unixMilli() ?? 0, tint: e.tint, url: e.url))
  host.send("widget", "set", json.encode(Set(kind: kind, entries: es)).bytes())
}

/// Clears what the kind of widget shows.
pub fn clear(kind: string) = setAll(kind, [])
