// Package platform/library saves a file where the user keeps theirs: a
// photo or a video to the photo library (iOS's Photos, Android's
// gallery), a download to Downloads, a song to Music. It asks for what
// it needs the first time.
//
//   let where = try await library.save(file, collection: .movies, folder: "Downloader", move: true)
//
// Through the host (platform/host): iOS, Android, and the desktops'
// Downloads, Pictures, Movies and Music folders.

import platform/host
import std/json

/// Where a file goes.
pub enum Collection {
  /// Android's Downloads; iOS's Files.
  downloads
  /// The gallery's videos; iOS's Photos.
  movies
  /// Music players' songs; iOS's Files.
  music
  /// The gallery's pictures; iOS's Photos.
  pictures
}

fn index(c: Collection) -> int = match c {
  .downloads => 0
  .movies => 1
  .music => 2
  .pictures => 3
}

struct Args {
  path: string
  collection: int
  name: string
  folder: string
  mime: string
  move: bool
}

/// The file's name: what's after its last slash.
fn base(path: string) -> string {
  let parts = path.split("/")
  return parts.last() ?? path
}

/// A type for a file's name, by its extension.
pub fn mimeOf(name: string) -> string {
  let parts = name.lower().split(".")
  if parts.count() < 2 {
    return "application/octet-stream"
  }
  return match parts.last() ?? "" {
    "jpg" | "jpeg" => "image/jpeg"
    "png" => "image/png"
    "heic" => "image/heic"
    "gif" => "image/gif"
    "webp" => "image/webp"
    "mp4" | "m4v" => "video/mp4"
    "mov" => "video/quicktime"
    "mp3" => "audio/mpeg"
    "m4a" => "audio/mp4"
    "wav" => "audio/wav"
    "pdf" => "application/pdf"
    "txt" => "text/plain"
    "zip" => "application/zip"
    _ => "application/octet-stream"
  }
}

/// Copies the file at path into collection (as name, in folder: a
/// folder of the collection's for the app's files; mime by default from
/// its extension), off the main thread, and answers where it went: a
/// content:// URI (Android), a Photos asset's identifier or a file
/// (iOS), a file (the desktops). move removes the file once it's saved.
pub async fn save(path: string, collection: Collection = .downloads, name: string = "", folder: string = "", mime: string = "", move: bool = false) throws -> string {
  let n = if name.isEmpty() { base(path) } else { name }
  let m = if mime.isEmpty() { mimeOf(n) } else { mime }
  let a = Args(path: path, collection: index(collection), name: n, folder: folder, mime: m, move: move)
  let b = try await host.call("library", "save", json.encode(a).bytes())
  return b.string()
}
