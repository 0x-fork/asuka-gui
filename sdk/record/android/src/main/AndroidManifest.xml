<?xml version="1.0" encoding="utf-8"?>
<!-- platform/record: the foreground service that keeps a recording going
     out of sight (Android 14's microphone type). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <application>
        <service android:name="platform.record.RecordService" android:exported="false" android:foregroundServiceType="microphone" />
    </application>
</manifest>
