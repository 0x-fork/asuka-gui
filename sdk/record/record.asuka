// Package platform/record records: sound from the microphone (a voice
// note, a podcast, speech for a transcription service), AAC in an MPEG-4
// file (.m4a) that platform/audio plays; and video from the camera.View on
// screen (platform/camera, in video mode). AVAudioRecorder on iOS and macOS,
// MediaRecorder on Android and the web, Media Foundation on Windows,
// GStreamer on Linux. An app that imports it is given the microphone's
// purpose string (asuka.toml's ios.usage.NSMicrophoneUsageDescription
// says it better).
//
//   let path = try await record.audio(maxDuration: 10s)   // until stopAudio(), or 10 s
//   audio.play(path)

import platform/camera

/// How sound is kept.
pub enum Quality {
  /// Speech: mono, 22.05 kHz, 64 kbit/s (about 0.5 MB a minute).
  voice
  /// Music and ambience: stereo where the microphone is, 44.1 kHz, 128
  /// kbit/s (about 1 MB a minute).
  music
}

/// Where a recording of sound is.
pub struct Status {
  /// How loud it is now, from 0 (silence, below -60 dB) to 1.
  level: float = 0
  /// It's recording (not paused, not stopped).
  recording: bool = false
  /// How much it has kept.
  elapsed: Duration = 0s
}

/// What recording fails with.
pub enum RecordError: Error {
  /// record: not allowed
  notAllowed
  /// record: already recording
  busy
}

/// The platform's recorder of sound.
/// @mainThread
native interface Recorder {
  /// Records into path ("": a new file in the app's caches) until stop
  /// (or maxDuration, if not 0): its file. background keeps it going out
  /// of sight (Android's foreground service, whose notification says
  /// title).
  async fn record(quality: Quality, maxDuration: Duration, path: string, background: bool, title: string) -> string
  fn stop()
  fn pause()
  fn resume()
  fn status() -> Status
}

let recorder = try? Recorder()

fn rec() throws -> Recorder {
  if let r = recorder {
    return r
  }
  return try Recorder()
}

/// Records sound from the microphone until stopAudio (or maxDuration, if
/// not 0), and gives the file (in the app's caches, unless path says
/// where: move it to keep it). It asks for the microphone the first
/// time. One at a time. background keeps it going out of sight: on iOS
/// the app needs "audio" in asuka.toml's ios.backgroundModes; on Android
/// it's a foreground service, its notification saying title, with a
/// button to stop.
pub async fn audio(maxDuration: Duration = 0s, quality: Quality = .voice, path: string = "", background: bool = false, title: string = "Recording") throws -> string {
  return try await rec().record(quality, maxDuration, path, background, title)
}

/// Ends the recording of sound: audio gives its file.
pub fn stopAudio() {
  if let r = recorder { try? r.stop() }
}

/// Pauses the recording of sound; resumeAudio goes on.
pub fn pauseAudio() {
  if let r = recorder { try? r.pause() }
}

/// Goes on with a recording of sound pauseAudio paused, into the same
/// file.
pub fn resumeAudio() {
  if let r = recorder { try? r.resume() }
}

/// Where the recording of sound is: read it a few times a second for a
/// level meter.
pub fn audioStatus() -> Status {
  if let r = recorder {
    return (try? r.status()) ?? Status()
  }
  return Status()
}

/// Records a video from the camera.View on screen (in video mode) until
/// stop (or maxDuration, if not 0), with the microphone unless mute: its
/// file (in the app's caches).
pub async fn start(maxDuration: Duration = 0s, mute: bool = false) throws -> string {
  return try await camera.record(mute: mute, maxDuration: maxDuration)
}

/// Ends the video's recording: start gives its file.
pub fn stop() {
  camera.stopRecording()
}
