// Package platform/recent keeps the documents the user opened lately where
// the system offers them again: the app's Open Recent menu and its Dock
// menu on macOS, the Recent category of its jump list on Windows, the
// user's recently used files on Linux (the file chooser's and the file
// manager's Recent). Choosing one opens the file with the app, as any
// file it's opened with. Record each document the user opens or saves. A
// phone has no recent documents of an app's (iOS's Files and Android's
// pickers keep their own): there add does nothing and list is empty.

import std/json
import platform/host

/// Records path (absolute) as a document the user opened: first among
/// the recent ones (one already there moves up).
pub fn add(path: string) {
  host.send("recent", "add", path.bytes())
}

/// Forgets the app's recent documents.
pub fn clear() {
  host.send("recent", "clear", bytes())
}

/// The app's recent documents, the latest first.
pub async fn list() -> [string] {
  if let b = try? await host.call("recent", "list", bytes()) {
    if b.count() > 0 {
      if let paths = try? json.decode<[string]>(b.string()) {
        return paths
      }
    }
  }
  return []
}
