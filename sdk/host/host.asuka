// Package platform/host reaches the hosts' own modules: what each
// platform's host does for an app beyond its views (the Dock tile, the
// taskbar, the tray, global shortcuts), by a module's and a method's
// name, with arguments and results encoded as the module says
// (little-endian). It's for the platform SDK's packages (platform/dock,
// platform/tray, ...); apps use those, and reach code of their own
// through native packages (docs/native.md).

/// Calls a module's method and waits for its result; a host without the
/// module throws.
pub native async fn call(module: string, method: string, args: bytes) throws -> bytes

/// Calls a module's method, not waiting for an answer.
pub native fn send(module: string, method: string, args: bytes)

/// An unsigned byte: n's low 8 bits.
pub native fn u8(n: int) -> bytes
/// 4 bytes of an int: n's low 32 bits, little-endian.
pub native fn u32(n: int) -> bytes
/// 8 bytes of an int, little-endian (a negative one in two's complement).
pub native fn u64(n: int) -> bytes
/// 8 bytes of a float: its IEEE 754 double, little-endian.
pub native fn f64(x: float) -> bytes
/// A string as a u32 length (in bytes) and its UTF-8.
pub native fn str(s: string) -> bytes

/// Reads what the encodings write, at a byte offset; a value that runs
/// past the end reads 0. This one: u8's byte.
pub native fn readU8(b: bytes, at: int) -> int
/// Reads u32's 4 bytes at a byte offset, unsigned (past the end: 0).
pub native fn readU32(b: bytes, at: int) -> int
/// Reads u64's 8 bytes at a byte offset (past the end: 0).
pub native fn readU64(b: bytes, at: int) -> int
/// Reads f64's 8 bytes at a byte offset (past the end: 0).
pub native fn readF64(b: bytes, at: int) -> float

/// The prelude's relaunch(), for a package that has a relaunch of its own
/// (platform/update's, which reloads the page on the web).
pub fn relaunchApp() { relaunch() }

/// The string at a u32 length (past the end: "").
pub native fn readStr(b: bytes, at: int) -> string

/// The process the app runs in: "share" (its own share sheet, an iOS
/// share extension or Android's :share process: platform/sharesheet),
/// "notification" (iOS's Notification Service Extension, which rewrites
/// a push: platform/push), "app" otherwise.
pub native fn process() -> string

/// Calls a module's method with a string (UTF-8) and answers its bytes as
/// text.
pub async fn callText(module: string, method: string, args: string) throws -> string {
  let b = try await call(module, method, args.bytes())
  return b.string()
}

/// A stream of what a module's "next" method gives (a host keeps what
/// comes until it's asked): each answer as bytes, until the stream is
/// left, when "stop" ends the call that waits.
pub fn next(module: string, method: string) -> Stream<bytes> = Stream(give => {
  defer { send(module, "stop", method.bytes()) }
  while true {
    let b = try await call(module, method, bytes())
    give(b)
  }
})

/// Whether an error is a host's saying it has no such module or method
/// (asuka test's fake host, a platform without it): a package answers
/// with its own unsupported or a fallback then.
pub fn unsupported(e: Error) -> bool {
  let m = e.message
  return m.hasPrefix("unsupported") || m.hasPrefix("not available") || m.hasPrefix("no module") || m.contains("isn't on") || m.contains("isn't in this app's host")
}
