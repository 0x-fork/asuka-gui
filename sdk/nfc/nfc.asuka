// Package platform/nfc reads and writes NFC tags: their NDEF messages, the
// tags themselves, and raw commands to them. iOS's Core NFC, with the
// system's sheet; Android's reader mode for the app's screen in front;
// Web NFC in Chrome on Android. A Mac, a PC and Linux have none: state()
// says unsupported and start throws notAvailable.
//
//   let s = try await nfc.start(alert: "Hold your iPhone near the tag.")
//   defer { s.stop() }
//   let t = try await s.next()
//   if let u = t.message?.uri() { link = u }
//
// A session looks for tags until it's stopped (or, on iOS, the user
// closes the sheet or it times out); next() waits for a tag. While the
// app holds a tag, it reads and writes its message, makes it read-only
// and sends it commands. Tags the system opens the app with (Android's
// nfc filters in asuka.toml) come through opened().
//
// Tests drive a fake: nfc.fake() is a FakeNfc a test taps tags on.

/// What NFC is here.
pub struct State {
  /// The device reads tags.
  supported: bool = false
  /// NFC is on (Android's setting; elsewhere, as supported).
  enabled: bool = false
}

/// Whether a tag holds an NDEF message.
pub enum Format {
  /// No NDEF, and the platform can't make it.
  notNDEF
  /// No NDEF yet: write formats the tag with its message.
  formatable
  readWrite
  readOnly
}

/// A tag's NDEF status.
pub struct NDEFInfo {
  format: Format = .notNDEF
  /// The largest message it holds, in bytes (encoded); -1 if not known.
  capacity: int = -1
  /// makeReadOnly can lock it.
  canMakeReadOnly: bool = false
  /// Android's NFC Forum type ("org.nfcforum.ndef.type2").
  type: string = ""

  /// write can write the tag.
  fn writable() -> bool = format == .readWrite || format == .formatable
}

/// What kinds of tags a session looks for.
pub enum Technology {
  /// ISO 14443-A: NTAG, MIFARE, most ISO 7816 cards.
  a
  /// ISO 14443-B: some identity cards.
  b
  /// FeliCa: Suica, nanaco, Octopus.
  f
  /// ISO 15693 (NFC-V): library and ski tags.
  v
}

/// A record's type name format.
pub enum TNF {
  empty
  wellKnown
  media
  absoluteURI
  external
  unknown
  unchanged
}

/// An NDEF record. Those a tag has that aren't one of the others are raw.
pub enum Record {
  /// A URI (well-known type "U").
  uri(string)
  /// A text (well-known type "T"), in a language (BCP 47).
  text(string, language: string)
  /// A MIME type's data.
  mime(type: string, data: bytes)
  /// An external type's, domain:name.
  external(type: string, data: bytes)
  /// An Android Application Record: Android opens the app of the package.
  androidApp(string)
  /// Any record, as it is.
  raw(tnf: TNF, type: bytes, id: bytes, payload: bytes)
}

/// An NDEF message: its records, in order.
pub struct Message {
  records: [Record] = []

  /// The first record's URI, if it holds one.
  fn uri() -> string? {
    if let r = records.first() {
      match r {
        .uri(u) => return u
        _ => return none
      }
    }
    return none
  }

  /// The first text record's text.
  fn text() -> string? {
    for r in records {
      match r {
        .text(t, _) => return t
        _ => {}
      }
    }
    return none
  }

  /// The message's bytes, as a tag holds them: short records where they
  /// fit, no chunks. An empty message is one empty record.
  fn encode() -> bytes = encodeMessage(self)
}

/// The NFC errors.
pub enum NfcError: Error {
  /// nfc: not available
  notAvailable
  /// nfc: turned off
  disabled
  /// nfc: not allowed
  denied
  /// nfc: canceled
  canceled
  /// nfc: timed out
  timeout
  /// nfc: the tag was lost
  tagLost
  /// nfc: the tag is read-only
  readOnly
  /// nfc: the message is too large for the tag
  tooLarge
  /// nfc: not supported by the tag
  notSupported
  /// nfc: not an NDEF message
  badMessage

  /// The error's text: "nfc: " and what went wrong, as each case's
  /// comment says.
  fn message() -> string = match self {
    .notAvailable => "nfc: not available"
    .disabled => "nfc: turned off"
    .denied => "nfc: not allowed"
    .canceled => "nfc: canceled"
    .timeout => "nfc: timed out"
    .tagLost => "nfc: the tag was lost"
    .readOnly => "nfc: the tag is read-only"
    .tooLarge => "nfc: the message is too large for the tag"
    .notSupported => "nfc: not supported by the tag"
    .badMessage => "nfc: not an NDEF message"
  }
}

/// A tag the platform found.
pub struct Tag {
  /// Its identifier (UID), none where the platform doesn't say (iOS's
  /// NDEF sessions, the web).
  id: bytes = bytes()
  /// Its technologies, as Android names them ("nfcA", "mifareUltralight",
  /// "isoDep", "ndef", ...).
  techs: [string] = []
  /// Its NDEF message, read as it was found (none: no NDEF, or skipNDEF).
  message: Message? = none
  ndef: NDEFInfo = NDEFInfo()
  private handle: int = 0

  /// Reads its NDEF message again.
  async fn read() throws -> Message? {
    let b = try await readTag(handle)
    if b.isEmpty() {
      return none
    }
    return try decode(b)
  }

  /// Writes m as its NDEF message (formatting a formatable tag).
  async fn write(m: Message) throws {
    try await writeTag(handle, m)
  }

  /// Locks it: its message can't be written again.
  async fn makeReadOnly() throws {
    try await lockTag(handle)
  }

  /// Sends a raw command (ISO-DEP's APDU, NFC-A's, FeliCa's) and returns
  /// the answer.
  async fn transceive(data: bytes) throws -> bytes {
    return try await transceiveTag(handle, data)
  }
}

/// A session that looks for tags.
pub struct Session {
  id: int = 0

  /// Waits for the next tag (iOS: in the sheet). Throws canceled when
  /// the user closes iOS's sheet, timeout after its sixty seconds.
  async fn next() throws -> Tag {
    return try await nextTag(id)
  }

  /// What iOS's sheet says.
  fn setAlert(alert: string) {
    setSessionAlert(id, alert)
  }

  /// Ends the session showing message as its failure (iOS's sheet).
  fn fail(message: string) {
    endSession(id, message)
  }

  /// Ends the session.
  fn stop() {
    endSession(id, "")
  }
}

// ---------------------------------------------------------------------
// The platform's side

/// A tag as it crosses: its message encoded.
struct Found {
  private handle: int = 0
  id: bytes = bytes()
  techs: [string] = []
  /// Its NDEF message's bytes, if it was read.
  hasMessage: bool = false
  message: bytes = bytes()
  format: Format = .notNDEF
  capacity: int = -1
  canMakeReadOnly: bool = false
  type: string = ""
}

/// A session's options.
struct Options {
  alert: string = ""
  /// []: tags with an NDEF message (iOS's NDEF session).
  poll: [Technology] = []
  skipNDEF: bool = false
  noSound: bool = false
  presenceDelay: Duration = 0ms
}

/// The platform's NFC.
native interface Reader {
  fn state() -> State
  async fn watchState(changed: fn(State))
  /// Begins a session: its ID. Throws notAvailable, disabled, denied.
  async fn begin(options: Options) -> int
  /// The session's next tag.
  async fn next(session: int) -> Found
  fn setAlert(session: int, alert: string)
  /// Ends a session; message "": stopped, else failed with it.
  fn end(session: int, message: string)
  async fn read(tag: int) -> bytes
  async fn write(tag: int, message: bytes)
  async fn makeReadOnly(tag: int)
  async fn transceive(tag: int, data: bytes) -> bytes
  /// Calls tag with each tag the system opens the app with, those since
  /// the app started first, until the task is cancelled.
  async fn opened(tag: fn(Found))
  async fn openSettings()
}

let platform = try? Reader()

state faked: FakeNfc? = none

fn stateNow() -> State {
  if let f = faked {
    return State(supported: f.supported, enabled: f.supported && f.enabled)
  }
  if let p = platform {
    return (try? p.state()) ?? State()
  }
  return State()
}

fn stateChanges() -> Stream<State> = Stream(send => {
  if let f = faked {
    send(stateNow())
    let id = f.onState(() => send(stateNow()))
    defer { f.unlisten(id) }
    await never()
  }
  if let p = platform {
    try await p.watchState(changed: s => send(s))
  } else {
    send(State())
  }
})

let followedState = live(stateNow(), stateChanges)

/// NFC here, tracked: read in a binding, it follows changes (Android's
/// NFC turned on or off) while it's read.
pub fn state() -> State = followedState()

/// Opens the system's NFC settings, for the user to turn it on
/// (Android); elsewhere notAvailable.
pub async fn openSettings() throws {
  if let f = faked {
    f.settings += 1
    return
  }
  if let p = platform {
    try await p.openSettings()
    return
  }
  throw NfcError.notAvailable
}

/// Begins a session that looks for tags (iOS shows its sheet, saying
/// alert). poll [] looks for tags with an NDEF message (iOS's NDEF
/// session, whose tags have no ID and take no commands); [.a, .b, .f, .v]
/// for those kinds with their IDs and commands. skipNDEF: don't read the
/// message as a tag is found (Android). noSound: Android plays none.
/// Throws notAvailable, disabled (Android: openSettings), denied (the
/// web's permission).
pub async fn start(alert: string = "", poll: [Technology] = [], skipNDEF: bool = false, noSound: bool = false, presenceDelay: Duration = 0ms) throws -> Session {
  let o = Options(alert: alert, poll: poll, skipNDEF: skipNDEF, noSound: noSound, presenceDelay: presenceDelay)
  if let f = faked {
    return Session(id: try f.begin(o))
  }
  if let p = platform {
    return Session(id: try await p.begin(options: o))
  }
  throw NfcError.notAvailable
}

fn tagOf(f: Found) throws -> Tag {
  var m: Message? = none
  if f.hasMessage {
    m = try? decode(f.message)
  }
  return Tag(id: f.id, techs: f.techs, message: m,
    ndef: NDEFInfo(format: f.format, capacity: f.capacity, canMakeReadOnly: f.canMakeReadOnly, type: f.type), handle: f.handle)
}

/// What a fake session does: a tag, or its end.
enum Happened {
  tapped(Found)
  ended(NfcError)
}

async fn nextTag(session: int) throws -> Tag {
  if let f = faked {
    let s: Stream<Happened> = Stream(send => {
      let id = f.wait(session, h => send(h))
      defer { f.unwait(id) }
      await never()
    })
    for await h in s {
      match h {
        .tapped(t) => return try tagOf(t)
        .ended(e) => throw e
      }
    }
    throw NfcError.canceled
  }
  if let p = platform {
    return try tagOf(try await p.next(session: session))
  }
  throw NfcError.notAvailable
}

fn setSessionAlert(session: int, alert: string) {
  if let f = faked {
    f.setAlert(session, alert)
    return
  }
  if let p = platform {
    try? p.setAlert(session: session, alert: alert)
  }
}

fn endSession(session: int, message: string) {
  if let f = faked {
    f.end(session, message)
    return
  }
  if let p = platform {
    try? p.end(session: session, message: message)
  }
}

async fn readTag(tag: int) throws -> bytes {
  if let f = faked {
    return try f.tagAt(tag).ndef
  }
  if let p = platform {
    return try await p.read(tag: tag)
  }
  throw NfcError.notAvailable
}

async fn writeTag(tag: int, m: Message) throws {
  let b = encodeMessage(m)
  if let f = faked {
    try f.write(tag, b)
    return
  }
  if let p = platform {
    try await p.write(tag: tag, message: b)
    return
  }
  throw NfcError.notAvailable
}

async fn lockTag(tag: int) throws {
  if let f = faked {
    try f.lock(tag)
    return
  }
  if let p = platform {
    try await p.makeReadOnly(tag: tag)
    return
  }
  throw NfcError.notAvailable
}

async fn transceiveTag(tag: int, data: bytes) throws -> bytes {
  if let f = faked {
    let t = try f.tagAt(tag)
    if let answer = t.answers[data.hex()] {
      return answer
    }
    throw NfcError.notSupported
  }
  if let p = platform {
    return try await p.transceive(tag: tag, data: data)
  }
  throw NfcError.notAvailable
}

/// The tags the system opens the app with, at launch or since (Android's
/// NDEF_DISCOVERED and TECH_DISCOVERED of asuka.toml's nfc filters); a
/// tag whose URI opened the app comes as the app's openURL instead.
pub fn opened() -> Stream<Tag> = Stream(send => {
  if let f = faked {
    let id = f.onOpen(t => {
      if let tag = try? tagOf(t) { send(tag) }
    })
    defer { f.unlisten(id) }
    await never()
  }
  if let p = platform {
    try await p.opened(tag: t => {
      if let tag = try? tagOf(t) { send(tag) }
    })
  }
})

// ---------------------------------------------------------------------
// NDEF

let uriPrefixes = ["", "http://www.", "https://www.", "http://", "https://", "tel:", "mailto:", "ftp://anonymous:anonymous@", "ftp://ftp.",
  "ftps://", "sftp://", "smb://", "nfs://", "ftp://", "dav://", "news:", "telnet://", "imap:", "rtsp://", "urn:", "pop:", "sip:", "sips:",
  "tftp:", "btspp://", "btl2cap://", "btgoep://", "tcpobex://", "irdaobex://", "file://", "urn:epc:id:", "urn:epc:tag:", "urn:epc:pat:",
  "urn:epc:raw:", "urn:epc:", "urn:nfc:"]

fn tnfOf(n: int) -> TNF = match n {
  0 => .empty
  1 => .wellKnown
  2 => .media
  3 => .absoluteURI
  4 => .external
  6 => .unchanged
  _ => .unknown
}

fn tnfNumber(t: TNF) -> int = match t {
  .empty => 0
  .wellKnown => 1
  .media => 2
  .absoluteURI => 3
  .external => 4
  .unknown => 5
  .unchanged => 6
}

/// A record's TNF, type, ID and payload.
fn parts(r: Record) -> (int, bytes, bytes, bytes) = match r {
  .uri(u) => uriParts(u)
  .text(t, lang) => (1, "T".bytes(), bytes(), bytes([lang.byteCount() % 64]).concat(lang.bytes()).concat(t.bytes()))
  .mime(type, data) => (2, type.bytes(), bytes(), data)
  .external(type, data) => (4, type.bytes(), bytes(), data)
  .androidApp(pkg) => (4, "android.com:pkg".bytes(), bytes(), pkg.bytes())
  .raw(tnf, type, id, payload) => (tnfNumber(tnf), type, id, payload)
}

fn uriParts(u: string) -> (int, bytes, bytes, bytes) {
  var code = 0
  var rest = u
  for (i, p) in uriPrefixes.enumerated() {
    if i > 0 && u.hasPrefix(p) && p.count() > uriPrefixes[code].count() {
      code = i
      rest = u.slice(p.count(), u.count())
    }
  }
  return (1, "U".bytes(), bytes(), bytes([code]).concat(rest.bytes()))
}

fn encodeMessage(m: Message) -> bytes {
  if m.records.isEmpty() {
    return bytes([0xd0, 0, 0])
  }
  var out = bytes()
  let n = m.records.count()
  for (i, r) in m.records.enumerated() {
    let (tnf, type, id, payload) = parts(r)
    var header = tnf
    if i == 0 { header += 0x80 }     // MB
    if i == n - 1 { header += 0x40 } // ME
    let short = payload.count() < 256
    if short { header += 0x10 }         // SR
    if !id.isEmpty() { header += 0x08 } // IL
    out = out.concat(bytes([header, type.count()]))
    if short {
      out = out.concat(bytes([payload.count()]))
    } else {
      let l = payload.count()
      out = out.concat(bytes([l / 16777216, l / 65536, l / 256, l]))
    }
    if !id.isEmpty() {
      out = out.concat(bytes([id.count()]))
    }
    out = out.concat(type).concat(id).concat(payload)
  }
  return out
}

/// Whether the flag mask (a power of two) is set in h.
fn bit(h: int, mask: int) -> bool = (h / mask) % 2 == 1

fn at(b: bytes, i: int) throws -> int {
  if let v = b.get(i) {
    return v
  }
  throw NfcError.badMessage
}

/// Reads an NDEF message's bytes: its records, chunked ones joined. A
/// message of one empty record (an empty tag's) has none.
pub fn decode(b: bytes) throws -> Message {
  var records: [Record] = []
  var i = 0
  var chunk: (int, bytes, bytes, bytes)? = none
  while i < b.count() {
    let h = try at(b, i)
    let tnf = h % 8
    let typeLen = try at(b, i + 1)
    i += 2
    var payloadLen = 0
    if bit(h, 0x10) {
      payloadLen = try at(b, i)
      i += 1
    } else {
      payloadLen = try at(b, i) * 16777216 + try at(b, i + 1) * 65536 + try at(b, i + 2) * 256 + try at(b, i + 3)
      i += 4
    }
    var idLen = 0
    if bit(h, 0x08) {
      idLen = try at(b, i)
      i += 1
    }
    if i + typeLen + idLen + payloadLen > b.count() {
      throw NfcError.badMessage
    }
    let type = b.slice(i, i + typeLen)
    let id = b.slice(i + typeLen, i + typeLen + idLen)
    let payload = b.slice(i + typeLen + idLen, i + typeLen + idLen + payloadLen)
    i += typeLen + idLen + payloadLen
    if bit(h, 0x20) {
      // A chunk: the rest follow, unchanged.
      if let c = chunk {
        let (t0, ty0, id0, p0) = c
        chunk = (t0, ty0, id0, p0.concat(payload))
      } else {
        chunk = (tnf, type, id, payload)
      }
    } else if let c = chunk {
      let (t0, ty0, id0, p0) = c
      records.push(recordOf(t0, ty0, id0, p0.concat(payload)))
      chunk = none
    } else {
      records.push(recordOf(tnf, type, id, payload))
    }
    if bit(h, 0x40) {
      break
    }
  }
  if records.count() == 1 {
    match records[0] {
      .raw(t, ty, id, p) => if t == .empty && ty.isEmpty() && p.isEmpty() { return Message() }
      _ => {}
    }
  }
  return Message(records: records)
}

fn recordOf(tnf: int, type: bytes, id: bytes, payload: bytes) -> Record {
  let t = type.string()
  if tnf == 1 && t == "U" && !payload.isEmpty() && id.isEmpty() {
    let code = payload.get(0)!
    let prefix = if code < uriPrefixes.count() { uriPrefixes[code] } else { "" }
    return .uri(prefix + payload.slice(1, payload.count()).string())
  }
  if tnf == 1 && t == "T" && !payload.isEmpty() && id.isEmpty() {
    let status = payload.get(0)!
    let langLen = status % 64
    if !bit(status, 0x80) && 1 + langLen <= payload.count() {
      return .text(payload.slice(1 + langLen, payload.count()).string(), language: payload.slice(1, 1 + langLen).string())
    }
  }
  if tnf == 2 && id.isEmpty() {
    return .mime(type: t, data: payload)
  }
  if tnf == 4 && t == "android.com:pkg" && id.isEmpty() {
    return .androidApp(payload.string())
  }
  if tnf == 4 && id.isEmpty() {
    return .external(type: t, data: payload)
  }
  return .raw(tnf: tnfOf(tnf), type: type, id: id, payload: payload)
}

// ---------------------------------------------------------------------
// Testing

/// A tag a fake taps.
pub struct FakeTag {
  id: bytes = bytes()
  /// Its NDEF message's bytes (Message.encode()); empty: no NDEF.
  ndef: bytes = bytes()
  readOnly: bool = false
  formatable: bool = false
  capacity: int = 888
  techs: [string] = []
  /// Answers to raw commands, by the command's hex.
  answers: [string: bytes] = [:]
  /// Messages written to it.
  writes: int = 0
}

/// The session a fake shows.
pub struct FakeSession {
  id: int = 0
  alert: string = ""
  poll: [Technology] = []
  /// How it ended: "" stopped, else the failure's message.
  failed: string = ""
}

/// NFC a test drives: fake() installs one. While a session looks
/// (session isn't none), tap() hands it a tag; cancel() is the user
/// closing iOS's sheet. tags are the tags tapped, as the app left them
/// (written, locked).
///
///   let n = nfc.fake()
///   ... the app starts a session ...
///   n.tap(nfc.FakeTag(ndef: nfc.Message(records: [nfc.Record.uri("https://example.com")]).encode()))
pub store FakeNfc {
  /// The device has NFC: false makes state() say unsupported and start
  /// throw notAvailable.
  pub state supported = true
  /// NFC is turned on (setEnabled changes it): false makes start throw
  /// disabled.
  pub state enabled = true
  /// The session looking for tags now, as the app started it (its alert,
  /// what it polls); none when there's none, or it ended.
  pub state session: FakeSession? = none
  /// Sessions begun.
  pub state sessions = 0
  /// How many times openSettings() was called.
  pub state settings = 0
  /// Every tag tapped or opened with, in order, as the app left it
  /// (written to, made read-only).
  pub state tags: [FakeTag] = []
  state waiters: [int: fn(Happened)] = [:]
  state stateReaders: [int: fn()] = [:]
  state openReaders: [int: fn(Found)] = [:]
  state queuedOpens: [Found] = []
  state nextID = 0

  fn id() -> int {
    nextID += 1
    return nextID
  }

  /// NFC turned on or off (Android's settings).
  pub fn setEnabled(on: bool) {
    enabled = on
    for r in stateReaders.values() { r() }
  }

  fn begin(o: Options) throws -> int {
    if !supported {
      throw NfcError.notAvailable
    }
    if !enabled {
      throw NfcError.disabled
    }
    if let s = session {
      end(s.id, "")
    }
    sessions += 1
    let s = FakeSession(id: id(), alert: o.alert, poll: o.poll)
    session = s
    return s.id
  }

  fn found(t: FakeTag, handle: int) -> Found {
    var format = Format.notNDEF
    if !t.ndef.isEmpty() {
      format = if t.readOnly { Format.readOnly } else { Format.readWrite }
    } else if t.formatable {
      format = .formatable
    }
    let techs = if t.techs.isEmpty() { ["ndef", "mifare", "nfcA", "mifareUltralight"] } else { t.techs }
    return Found(handle: handle, id: t.id, techs: techs, hasMessage: !t.ndef.isEmpty(), message: t.ndef, format: format,
      capacity: t.capacity, canMakeReadOnly: !t.readOnly)
  }

  /// A tag near the device: the session looking gets it.
  pub fn tap(t: FakeTag) {
    tags.push(t)
    let f = found(t, tags.count())
    for w in waiters.values() { w(Happened.tapped(f)) }
  }

  /// The user closes iOS's sheet.
  pub fn cancel() {
    if let s = session {
      session = none
      for w in waiters.values() { w(Happened.ended(NfcError.canceled)) }
    }
  }

  /// The system opens the app with t (Android's filters).
  pub fn open(t: FakeTag) {
    tags.push(t)
    let f = found(t, tags.count())
    if openReaders.isEmpty() {
      queuedOpens.push(f)
    } else {
      for r in openReaders.values() { r(f) }
    }
  }

  fn tagAt(handle: int) throws -> FakeTag {
    if handle < 1 || handle > tags.count() {
      throw NfcError.tagLost
    }
    return tags[handle - 1]
  }

  fn write(handle: int, b: bytes) throws {
    let t = try tagAt(handle)
    if t.readOnly {
      throw NfcError.readOnly
    }
    if b.count() > t.capacity {
      throw NfcError.tooLarge
    }
    tags[handle - 1].ndef = b
    tags[handle - 1].writes += 1
  }

  fn lock(handle: int) throws {
    let _ = try tagAt(handle)
    tags[handle - 1].readOnly = true
  }

  fn setAlert(s: int, alert: string) {
    if let cur = session {
      if cur.id == s {
        session = FakeSession(id: cur.id, alert: alert, poll: cur.poll)
      }
    }
  }

  fn end(s: int, message: string) {
    if let cur = session {
      if cur.id == s {
        session = none
      }
    }
  }

  fn wait(s: int, f: fn(Happened)) -> int {
    let i = id()
    waiters[i] = f
    if let cur = session {
      if cur.id != s {
        f(Happened.ended(NfcError.canceled))
      }
    } else {
      f(Happened.ended(NfcError.canceled))
    }
    return i
  }

  fn unwait(i: int) {
    waiters.remove(i)
  }

  fn onState(f: fn()) -> int {
    let i = id()
    stateReaders[i] = f
    return i
  }

  fn onOpen(f: fn(Found)) -> int {
    let i = id()
    openReaders[i] = f
    let q = queuedOpens
    queuedOpens = []
    for t in q { f(t) }
    return i
  }

  fn unlisten(i: int) {
    stateReaders.remove(i)
    openReaders.remove(i)
  }
}

/// Installs a FakeNfc, for a test: from now on the package reads tags
/// with it, not the platform.
pub fn fake() -> FakeNfc {
  let f = FakeNfc()
  faked = f
  return f
}
