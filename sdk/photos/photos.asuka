// Package platform/photos reads the user's photo library, with their
// permission: PhotoKit on iOS, MediaStore on Android. It's for an app
// whose screen is the library (a gallery, an editor); to let the user
// pick a few photos, a picker asks for no permission.
//
//   if try await photos.request() != .denied {
//     let assets = try await photos.list(screenshots: true, limit: 60)
//     let thumb = try await photos.thumbnail(assets[0].id, size: 300)
//   }

import platform/host
import std/json
import std/time

/// What the user has allowed.
pub enum Access {
  notAsked
  denied
  /// Only the photos the user chose (iOS 14, Android 14).
  limited
  allowed
}

fn accessOf(s: string) -> Access = match s {
  "allowed" => .allowed
  "limited" => .limited
  "denied" => .denied
  _ => .notAsked
}

/// A photo in the library.
pub struct Asset {
  id: string = ""
  width: int = 0
  height: int = 0
  /// When it was taken.
  created: time.Time = time.unix(0)
  screenshot: bool = false
}

// An asset as the hosts say it: created in milliseconds since 1970.
struct WireAsset {
  id: string = ""
  width: int = 0
  height: int = 0
  created: int = 0
  screenshot: bool = false
}

/// A photo as a file: a copy in the app's caches.
pub struct File {
  path: string = ""
  /// Its name in the library (IMG_0042.HEIC).
  name: string = ""
}

/// What the user has allowed, without asking.
pub async fn current() throws -> Access = accessOf((try await host.call("photoLibrary", "current", bytes())).string())

/// Asks the user the first time, and answers what they've allowed.
pub async fn request() throws -> Access = accessOf((try await host.call("photoLibrary", "request", bytes())).string())

/// Lets a user who allowed only some photos change which; it returns
/// once that's closed: list again.
pub async fn manageLimited() throws {
  let _ = try await host.call("photoLibrary", "manage", bytes())
}

struct Query {
  screenshots: bool
  offset: int
  limit: int
}

/// The photos, newest first, from offset, at most limit; screenshots
/// keeps only those.
pub async fn list(screenshots: bool = false, offset: int = 0, limit: int = 100) throws -> [Asset] {
  let q = Query(screenshots: screenshots, offset: offset, limit: if limit <= 0 { 100 } else { limit })
  let b = try await host.call("photoLibrary", "list", json.encode(q).bytes())
  let ws: [WireAsset] = try json.decode(b.string())
  return ws.map(w => Asset(id: w.id, width: w.width, height: w.height, created: time.unixMilli(w.created), screenshot: w.screenshot))
}

struct Thumb {
  id: string
  size: int
}

/// A JPEG file of the photo, at least size pixels on its short side,
/// kept in the app's caches.
pub async fn thumbnail(id: string, size: int = 300) throws -> string {
  let b = try await host.call("photoLibrary", "thumbnail", json.encode(Thumb(id: id, size: size)).bytes())
  return b.string()
}

/// Copies the photo's full image as it is in the library (HEIC, JPEG,
/// PNG) to a file; an iCloud photo downloads first.
pub async fn export(id: string) throws -> File {
  let b = try await host.call("photoLibrary", "export", json.encode(["id": id]).bytes())
  return try json.decode(b.string())
}
