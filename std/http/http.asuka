// Package asuka/http makes HTTP requests through each platform's own
// client: URLSession on iOS and macOS, HttpURLConnection on Android,
// fetch on the web, WinHTTP on Windows and libsoup on Linux. So proxies,
// certificates the user trusts, and the system's caches and cookies
// work as they do for the platform's own apps.
//
//   let r = try await http.get("https://example.com/inbox.json")
//   let inbox = try r.json<[Message]>()
//
// A large answer goes into a file as it comes, its progress reported:
//
//   try await http.download(url, path, progress: (got, total) => { done = got })

import asuka/fs
import asuka/json as codec

/// What a request answered.
pub struct Response {
  /// The status code: 200, 404...
  status: int
  /// The URL it answered from, after redirects.
  url: string
  /// The headers, by lower-case name.
  headers: [string: string]
  body: bytes

  /// The body as UTF-8 text.
  fn text() -> string = body.string()

  /// The body as JSON, decoded into T.
  fn json<T>() throws -> T = try codec.decode<T>(text())

  /// Whether the status is a success (200 to 299).
  fn ok() -> bool = status >= 200 && status < 300
}

/// The platform's HTTP client.
native interface Transport {
  /// Sends a request and waits for its answer: a network failure throws,
  /// an answer of any status returns.
  async fn send(method: string, url: string, headers: [string: string], body: bytes, timeout: Duration) -> Response
  /// Sends a request and writes its answer's body into the file at path
  /// as it comes (a file beside it, renamed to path once it's all in),
  /// calling progress with the bytes written and the whole's (-1 when
  /// the answer doesn't say). timeout is the longest wait for more. Its
  /// Response's body is empty. Where the platform can't write the app's
  /// files from its client, it answers with the body for the caller to
  /// write.
  async fn download(method: string, url: string, headers: [string: string], body: bytes, timeout: Duration, path: string, progress: fn(int, int)) -> Response
}

// Made once; none where the platform has no client (making one again
// says why).
let transport = try? Transport()

/// Sends a request: method (GET, POST...), url, headers, body, and how
/// long to wait for the answer.
pub async fn request(method: string, url: string, headers: [string: string] = [:], body: bytes = bytes(), timeout: Duration = 60s) throws -> Response {
  if let t = transport {
    return try await t.send(method, url, headers, body, timeout)
  }
  return try await Transport().send(method, url, headers, body, timeout)
}

pub async fn get(url: string, headers: [string: string] = [:]) throws -> Response {
  return try await request("GET", url, headers: headers)
}

pub async fn post(url: string, body: bytes, headers: [string: string] = [:]) throws -> Response {
  return try await request("POST", url, headers: headers, body: body)
}

/// Posts value as JSON.
pub async fn postJSON<T>(url: string, value: T, headers: [string: string] = [:]) throws -> Response {
  var h = headers
  h["content-type"] = "application/json"
  return try await request("POST", url, headers: h, body: codec.encode(value).bytes())
}

/// Downloads url into the file at path as the answer comes, made (or
/// replaced) once it's all in: a video, an archive, what's too large to
/// hold. progress, if given, is called as it goes with the bytes written
/// and the whole's (-1 when the server doesn't say), at most a few times
/// a second. timeout is the longest wait for more bytes, not for the
/// whole. It answers with the Response, its body empty; a status that
/// isn't a success is the caller's to check (the file then holds what
/// the server said). Cancelling the task stops it, leaving no file.
pub async fn download(url: string, path: string, headers: [string: string] = [:], method: string = "GET", body: bytes = bytes(), timeout: Duration = 60s, progress: fn(int, int)? = none) throws -> Response {
  let report = (got: int, total: int) => {
    if let p = progress { p(got, total) }
  }
  let t = transport ?? try Transport()
  var r = try await t.download(method, url, headers, body, timeout, path, report)
  if !r.body.isEmpty() {
    // The web's client hands the body over: the app's files are the
    // core's.
    try fs.write(path, r.body)
    report(r.body.count(), r.body.count())
    r.body = bytes()
  }
  return r
}
