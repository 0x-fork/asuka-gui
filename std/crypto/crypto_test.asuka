import std/encoding

fn hex(s: string) -> bytes = (try? encoding.hexDecode(s)) ?? bytes()

test "hashes" {
  expect(sha384("abc".bytes()).hex() == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
  expect(md5("message digest".bytes()).hex() == "f96b697d7cb7938d525a2f31aaf161d0")
  expect(Hash.sha384.size() == 48 && sha512(bytes()).count() == Hash.sha512.size())
}

test "MACs and key derivation" {
  // RFC 4231's test case 2.
  let key = "Jefe".bytes()
  let data = "what do ya want for nothing?".bytes()
  expect(hmacSHA256(key, data).hex() == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  expect(hmac(key, data) == hmacSHA256(key, data))
  expect(hmacSHA512(key, data).hex() == "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
  expect(hmac(key, data, hash: .sha512) == hmacSHA512(key, data))
  // RFC 5869's A.1, in one step and in two.
  let ikm = hex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
  let salt = hex("000102030405060708090a0b0c")
  let info = hex("f0f1f2f3f4f5f6f7f8f9")
  let okm = "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
  expect((try hkdf(ikm, salt: salt, info: info, length: 42)).hex() == okm)
  let prk = hkdfExtract(ikm, salt: salt)
  expect(prk.hex() == "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
  expect((try hkdfExpand(prk, info: info, length: 42)).hex() == okm)
  expect((try hkdf(ikm, length: 255 * 32)).count() == 8160)
  expect((try? hkdf(ikm, length: 255 * 32 + 1)) == none)
  // RFC 6070's and RFC 7914's PBKDF2.
  expect((try pbkdf2("password".bytes(), salt: "salt".bytes(), iterations: 2, length: 20, hash: .sha1)).hex() == "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957")
  expect((try pbkdf2("passwd".bytes(), salt: "salt".bytes(), iterations: 1, length: 64)).hex() == "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783")
  expect((try? pbkdf2("p".bytes(), salt: "s".bytes(), iterations: 0)) == none)
}

test "seal and open" {
  let message = "the note".bytes()
  let id = "note 7".bytes()
  for c in [Cipher.xChaCha20Poly1305, .chaCha20Poly1305, .aes256GCM, .aes128GCM] {
    let key = newKey(cipher: c)
    expect(key.count() == c.keySize())
    let sealed = try seal(key, message, additionalData: id, cipher: c)
    expect(sealed.count() == c.nonceSize() + message.count() + tagSize)
    expect(try open(key, sealed, additionalData: id, cipher: c) == message)
    // Each seal's nonce is its own.
    expect(try seal(key, message, cipher: c) != try seal(key, message, cipher: c))
    // Another key, other additional data, a changed byte, a cut: not authentic.
    let other = newKey(cipher: c)
    var changed: [int] = []
    for i in 0..<sealed.count() {
      changed.push(if i == sealed.count() - 1 { sealed[i] ^ 1 } else { sealed[i] })
    }
    let wrongs = [
      try? open(other, sealed, additionalData: id, cipher: c),
      try? open(key, sealed, cipher: c),
      try? open(key, bytes(changed), additionalData: id, cipher: c),
      try? open(key, sealed.slice(0, 20), additionalData: id, cipher: c),
    ]
    for w in wrongs {
      expect(w == none)
    }
    do {
      let _ = try open(other, sealed, additionalData: id, cipher: c)
      expect(false)
    } catch e {
      expect(e.message == CryptoError.notAuthentic.message())
    }
  }
  // The default is XChaCha20-Poly1305: a 24-byte nonce first.
  let key = newKey()
  expect((try seal(key, message)).count() == 24 + 8 + 16)
  // A key of the wrong size throws invalidKey; a nonce, invalidArgument.
  do {
    let _ = try seal(randomBytes(16), message)
    expect(false)
  } catch e {
    expect(e.message == CryptoError.invalidKey("XChaCha20-Poly1305 takes a key of 32 bytes, not 16").message())
  }
  expect((try? sealWithNonce(key, nonce: randomBytes(12), plaintext: message)) == none)
  // RFC 8439's 2.8.2, with its nonce.
  let rfcKey = hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
  let plain = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".bytes()
  let sealed = try sealWithNonce(rfcKey, nonce: hex("070000004041424344454647"), plaintext: plain, additionalData: hex("50515253c0c1c2c3c4c5c6c7"), cipher: .chaCha20Poly1305)
  expect(sealed.slice(sealed.count() - 16, sealed.count()).hex() == "1ae10b594f09e26a7e902ecbd0600691")
  expect(try openWithNonce(rfcKey, nonce: hex("070000004041424344454647"), ciphertext: sealed, additionalData: hex("50515253c0c1c2c3c4c5c6c7"), cipher: .chaCha20Poly1305) == plain)
}

test "passwords" {
  let stored = try await hashPassword("correct horse", memory: 64, iterations: 1, parallelism: 1)
  expect(stored.hasPrefix("$argon2id$v=19$m=64,t=1,p=1$"))
  expect(try await verifyPassword("correct horse", hash: stored))
  expect(!(try await verifyPassword("correct horsf", hash: stored)))
  // What Go's x/crypto made.
  expect(try await verifyPassword("password", hash: "$argon2id$v=19$m=256,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$yrdGtGIZk/3JHsUHh5gLQUqQppLwvGjf4Z+cJbPLqew"))
  expect(try await verifyPassword("correct horse", hash: "$2a$04$VejEAP.xI73txC6VB4Y3rOZ61EZHlpUFMV2Vx7JfXfCPiL45lIGVm"))
  let b = try await hashPasswordBcrypt("correct horse", cost: 4)
  expect(b.hasPrefix("$2b$04$") && b.count() == 60)
  expect(try await verifyPassword("correct horse", hash: b))
  // What isn't a hash, and what can't be hashed, throw invalidArgument.
  do {
    let _ = try await verifyPassword("x", hash: "plain text")
    expect(false)
  } catch e {
    expect(e.message.hasPrefix("invalid argument: it isn't an argon2 hash"))
  }
  expect((try? await hashPassword("x", memory: 4)) == none)
  expect((try? await hashPasswordBcrypt("a".repeat(73))) == none)
  // A key from a password: argon2id's raw output.
  let k = try await argon2id("password".bytes(), salt: "somesaltsomesalt".bytes(), memory: 256, iterations: 2, parallelism: 1)
  expect(k.hex() == "cab746b4621993fdc91ec50787980b414a90a692f0bc68dfe19f9c25b3cba9ec")
}

