// Package asuka/contacts is the user's contacts: one they pick, which
// needs no permission, or all of them, with it (request, list); and a
// new one, added through the system's own form.
//
//   if let c = try await contacts.pick() { Text("{c.name}, {c.phones.count()} phones") }

import asuka/host
import asuka/json

/// A phone number or an address, with what it is ("mobile", "work").
pub struct Item {
  label: string = ""
  value: string = ""
}

/// A contact.
pub struct Contact {
  id: string = ""
  /// As the platform shows it.
  name: string = ""
  givenName: string = ""
  familyName: string = ""
  organization: string = ""
  jobTitle: string = ""
  phones: [Item] = []
  emails: [Item] = []
  /// "yyyy-MM-dd", or "--MM-dd" without a year.
  birthday: string = ""
  note: string = ""
}

/// The app's access to the contacts.
pub enum Access {
  notAsked
  denied
  /// iOS 18: the contacts the user chose.
  limited
  allowed
}

fn accessOf(b: bytes) -> Access = match host.readU8(b, 0) {
  1 => .denied
  2 => .limited
  3 => .allowed
  _ => .notAsked
}

fn notAllowed(e: Error) -> Error = if e.message == "not allowed" { Error("contacts: not allowed") } else { e }

/// Asks the user for access the first time, and answers what they allow.
pub async fn request() throws -> Access {
  let b = try await host.call("contacts", "request", bytes())
  if b.isEmpty() {
    return .notAsked
  }
  return accessOf(b)
}

struct Query {
  name: string
  limit: int
}

/// The contacts whose name has name ("": all), at most limit (0: no
/// limit). Without access: "contacts: not allowed".
pub async fn list(name: string = "", limit: int = 0) throws -> [Contact] {
  do {
    let b = try await host.call("contacts", "list", json.encode(Query(name: name, limit: limit)).bytes())
    return try json.decode(b.string())
  } catch e {
    throw notAllowed(e)
  }
}

/// Shows the system's contact picker: the contact picked, or none.
pub async fn pick() throws -> Contact? {
  let b = try await host.call("contacts", "pick", bytes())
  if b.isEmpty() {
    return none
  }
  let c: Contact = try json.decode(b.string())
  return c
}

/// Shows the system's new contact form with c filled in: whether the
/// user saved it.
pub async fn add(c: Contact) throws -> bool {
  let b = try await host.call("contacts", "add", json.encode(c).bytes())
  return host.readU8(b, 0) == 1
}
