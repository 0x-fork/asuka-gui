// Package asuka/secure keeps small secrets (tokens, passwords) encrypted
// by the platform: the Keychain on iOS and the Mac; on Android, values
// sealed with a key in the Android Keystore; Windows' Credential
// Manager; the user's keyring on Linux (libsecret: GNOME Keyring,
// KWallet); on the web, IndexedDB under a WebCrypto key the page can use
// but not read (a web app's best, not a keychain). For secrets, not data:
// asuka/store keeps the rest.
//
//   try await secure.write("token", token)
//   let token = try await secure.read("token") ?? ""
//   try await secure.remove("token")
//
// The names are asuka/store's (read, write, remove).

/// The platform's keychain.
native interface Keychain {
  /// key's value; none if there's none.
  async fn get(key: string) -> string?
  /// Keeps value as key's, replacing what was there.
  async fn set(key: string, value: string)
  /// Forgets key (nothing there is no error).
  async fn remove(key: string)
}

// Made once; none where the platform has no code for it.
let keychain = try? Keychain()

fn made() throws -> Keychain {
  if let k = keychain {
    return k
  }
  throw Error("unsupported: no secure store here")
}

/// Keeps value as key's, encrypted by the platform, replacing what was
/// there.
pub async fn write(key: string, value: string) throws {
  try await made().set(key: key, value: value)
}

/// key's value; none if there's none.
pub async fn read(key: string) throws -> string? {
  return try await made().get(key: key)
}

/// Forgets key; nothing there is no error.
pub async fn remove(key: string) throws {
  try await made().remove(key: key)
}
