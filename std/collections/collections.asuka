// Package std/collections is the collections past arrays, maps and sets,
// for what's done by order: a priority queue (Heap), for the next job
// due or the k largest, and a map and a set kept in their keys' order
// (SortedMap, SortedSet), for ranges, the first and the last, and the
// nearest key to one.
//
//   import std/collections.{Heap, SortedMap}
//
//   var jobs = Heap<Job>(by: (a, b) => a.due < b.due)   // the earliest due first
//   jobs.push(job)
//   let next = jobs.pop()
//
//   var prices = SortedMap<int, float>()
//   prices.set(at, 101.5)
//   for (t, p) in prices.range(from: start, to: end) { … }
//   let before = prices.floor(at)                       // the last at or before
//
// An array is the double-ended queue: push and pop at its end, pushFirst
// and popFirst at its start, each O(1) (amortized).
//
// They're values, as arrays and maps are: a copy doesn't see the
// original's later changes. A copy is cheap: copies share their storage
// until one changes, and then a Heap copies its array, a SortedMap only
// the nodes on its path from the root (O(log n)).
//
// Each keeps the order it was made with, by: a less-than, as sorted(by:)
// takes; a SortedMap's and a SortedSet's are their keys' own (<) unless
// one is given (by is none then: the keys are compared in place, no
// closure called). They're compared (==), hashed (a map's keys, a Set's
// elements), printed and written as JSON by their contents, whatever
// their orders: a Heap and a SortedSet as an array of their elements in
// their order, a SortedMap as an object when its keys are strings, else
// as an array of {"key", "value"} objects (Entry). json.decode reads them
// back, ordered by their elements' (keys') own <.
//
// Heap: push, pop and pushPop are O(log n), peek O(1), Heap.of (and
// Heap.min and Heap.max, by T's own <) O(n).
// SortedMap and SortedSet are B-trees: get, set, remove, floor and the
// rest O(log n); range(from:to:) O(log n) to its first entry, then O(1)
// each (amortized); first() and last() O(log n). Their lazy() and range
// are Seqs: for goes over them, and their map, filter and take compute
// only what's read.

/// A priority queue: pop gives the least element by its order, by, a
/// less-than: (a, b) => a.due < b.due gives the earliest due first,
/// (a, b) => a > b the greatest. push and pop are O(log n), peek O(1).
///
///   var top = Heap<int>(by: (a, b) => a < b)
///   for x in [5, 1, 4] { top.push(x) }
///   top.pop()                                   // 1
pub struct Heap<T> {
  /// The order: a less-than. pop gives the least by it first.
  by: fn(T, T) -> bool
  // The elements as a binary heap keeps them, the least first.
  private items: [T] = []

  /// A heap of items' elements, ordered by by (a less-than): O(n), where
  /// pushing them one by one is O(n log n).
  ///
  ///   var jobs = Heap.of(pending, by: (a, b) => a.due < b.due)
  static fn of(items: [T], by: fn(T, T) -> bool) -> Heap<T> {
    var h = Heap(by: by, items: items)
    var i = items.count() / 2 - 1
    while i >= 0 {
      h.items.siftDown(i, by)
      i -= 1
    }
    return h
  }

  /// The number of elements.
  fn count() -> int = items.count()

  /// Whether there are none.
  fn isEmpty() -> bool = items.isEmpty()

  /// The least element, which pop would give, or none when it's empty.
  fn peek() -> T? = if items.isEmpty() { none } else { items[0] }

  /// Adds x: O(log n).
  mut fn push(x: T) {
    items.push(x)
    items.siftUp(items.count() - 1, by)
  }

  /// Removes and returns the least element, none when it's empty:
  /// O(log n).
  mut fn pop() -> T? {
    if items.isEmpty() { return none }
    let last = items.removeAt(items.count() - 1)
    if items.isEmpty() { return last }
    let top = items[0]
    items[0] = last
    items.siftDown(0, by)
    return top
  }

  /// Adds x and removes the least, which may be x itself: one O(log n)
  /// step, as push then pop. Keeping the k greatest of many is pushPop
  /// once there are k, by (a, b) => a < b.
  mut fn pushPop(x: T) -> T {
    if items.isEmpty() || !by(items[0], x) { return x }
    let top = items[0]
    items[0] = x
    items.siftDown(0, by)
    return top
  }

  /// Removes the least and adds x, as pop then push: one O(log n) step.
  /// None, with x added, when it was empty.
  mut fn replace(x: T) -> T? {
    if items.isEmpty() {
      items.push(x)
      return none
    }
    let top = items[0]
    items[0] = x
    items.siftDown(0, by)
    return top
  }

  /// Removes every element.
  mut fn clear() { items.clear() }

  /// The elements in pop's order, the least first: O(n log n). The heap
  /// stays as it is.
  fn sorted() -> [T] = items.sorted(by: by)

  /// The elements in pop's order, as a Seq: sorted when it's made.
  fn lazy() -> Seq<T> = sorted().lazy()

  /// What for goes over: the elements in pop's order, as lazy() gives.
  fn iter() -> Seq<T> = lazy()
}

// A binary heap's steps, on its array (Heap's items), by its less-than.
extend<T> [T] {
  mut fn siftUp(from: int, by: fn(T, T) -> bool) {
    var i = from
    let x = self[i]
    while i > 0 {
      let p = (i - 1) / 2
      if !by(x, self[p]) { break }
      self[i] = self[p]
      i = p
    }
    self[i] = x
  }

  mut fn siftDown(from: int, by: fn(T, T) -> bool) {
    let n = count()
    var i = from
    let x = self[i]
    var c = 2 * i + 1
    while c < n {
      if c + 1 < n && by(self[c + 1], self[c]) { c += 1 }
      if !by(self[c], x) { break }
      self[i] = self[c]
      i = c
      c = 2 * i + 1
    }
    self[i] = x
  }
}

extend<T: Comparable> Heap<T> {
  /// A heap that pops the least first, by T's own <, of items'
  /// elements (none: an empty one): O(n).
  ///
  ///   var due = Heap.min([5, 1, 4])
  ///   due.pop()                                   // 1
  pub static fn min(items: [T] = []) -> Heap<T> = Heap.of(items, by: (a, b) => a < b)

  /// A heap that pops the greatest first, by T's own <: O(n).
  pub static fn max(items: [T] = []) -> Heap<T> = Heap.of(items, by: (a, b) => a > b)
}

// ---- SortedMap and SortedSet: a B-tree ----

// The entries are in the runtime's B-tree (core/src/rt/tree.c), a
// BTree<K, V>: its nodes hold their keys, values and children in one
// allocation, and are shared by copies of a map until one changes, which
// copies only those on its path from the root. Its keys are ordered by
// by, a less-than, or, none, by their own < in C (ints, floats, strings,
// chars, sized integers, an enum's cases) or their type's own compare:
// no closure called a comparison. Its methods are the runtime's
// (lang/check/methods.go's "tree"); a change (put, add, take, delete)
// changes the tree in its place, as an array's push does.

// newTree and newSet are an empty map's tree and an empty set's (keys
// only), ordered by K's own < (core/src/std/collections.c).
native fn newTree<K, V>() -> BTree<K, V>
native fn newSet<T>() -> BTree<T, bool>

// A Cursor is where a walk of a tree is: at the first key not less than
// at (after: greater than it; none: the first), and how many entries
// its next step reads (more each step, so that a walk that stops early
// reads few, and one that goes on calls the tree seldom); done after the
// last.
private struct Cursor<K> {
  at: K? = none
  after: bool = false
  size: int = 16
  done: bool = false
}

// mapWalk is a map's entries from the key from (with it) up to to
// (without), in order, as a Seq that reads them a run at a time.
fn mapWalk<K: Comparable, V>(t: BTree<K, V>, from: K?, to: K?, by: (fn(K, K) -> bool)?) -> Seq<(K, V)> {
  let start = Cursor<K>(at: from)
  return Seq(state: start, next: c => mapStep(t, c, to, by)).flatMap(run => run.lazy())
}

fn mapStep<K: Comparable, V>(t: BTree<K, V>, c: Cursor<K>, to: K?, by: (fn(K, K) -> bool)?) -> ([(K, V)], Cursor<K>)? {
  if c.done { return none }
  let run = t.entries(c.at, c.after, to, by, c.size)
  if run.isEmpty() { return none }
  let next = Cursor<K>(at: run[run.count() - 1].0, after: true, size: min(c.size * 2, 1024), done: run.count() < c.size)
  return (run, next)
}

// setWalk is a set's elements from from up to to, likewise.
fn setWalk<T: Comparable>(t: BTree<T, bool>, from: T?, to: T?, by: (fn(T, T) -> bool)?) -> Seq<T> {
  let start = Cursor<T>(at: from)
  return Seq(state: start, next: c => setStep(t, c, to, by)).flatMap(run => run.lazy())
}

fn setStep<T: Comparable>(t: BTree<T, bool>, c: Cursor<T>, to: T?, by: (fn(T, T) -> bool)?) -> ([T], Cursor<T>)? {
  if c.done { return none }
  let run = t.keys(c.at, c.after, to, by, c.size)
  if run.isEmpty() { return none }
  let next = Cursor<T>(at: run[run.count() - 1], after: true, size: min(c.size * 2, 1024), done: run.count() < c.size)
  return (run, next)
}

/// Entries kept in their keys' order: a map whose keys are sorted, for
/// ranges (range(from:to:)), the least and the greatest (first, last),
/// and the nearest key to one (floor, ceiling, lower, higher). The keys
/// are ordered by by, their own < unless it's given. get, set and remove
/// are O(log n).
///
///   var scores = SortedMap<string, int>()
///   scores.set("bo", 3)
///   scores.set("al", 7)
///   scores.first()                                  // ("al", 7)
///   for (name, score) in scores { … }               // al, then bo
pub struct SortedMap<K: Comparable, V> {
  /// The keys' order, a less-than ((a, b) => a > b: the greatest
  /// first); none, the default, is their own <.
  by: (fn(K, K) -> bool)? = none
  // The entries, in the runtime's B-tree.
  private tree: BTree<K, V> = newTree<K, V>()

  /// The number of entries.
  fn count() -> int = tree.count()

  /// Whether there are none.
  fn isEmpty() -> bool = tree.count() == 0

  /// key's value, none when it has none: O(log n).
  fn get(key: K) -> V? = tree.get(key, by)

  /// Whether key has a value.
  fn has(key: K) -> bool = tree.has(key, by)

  /// Gives key value, in its place by its order: O(log n).
  mut fn set(key: K, value: V) {
    let _ = tree.put(key, value, by)
  }

  /// Removes key and returns its value, none when it had none: O(log n).
  mut fn remove(key: K) -> V? {
    return tree.take(key, by)
  }

  /// Removes every entry.
  mut fn clear() {
    tree = newTree<K, V>()
  }

  /// The entry with the least key, none when it's empty.
  fn first() -> (K, V)? = tree.end(false)

  /// The entry with the greatest key, none when it's empty.
  fn last() -> (K, V)? = tree.end(true)

  /// Removes and returns the entry with the least key.
  mut fn popFirst() -> (K, V)? {
    let e = first() else { return none }
    let _ = remove(e.0)
    return e
  }

  /// Removes and returns the entry with the greatest key.
  mut fn popLast() -> (K, V)? {
    let e = last() else { return none }
    let _ = remove(e.0)
    return e
  }

  /// The entry with the greatest key at or before key (by the order):
  /// key's own when it has one.
  fn floor(key: K) -> (K, V)? = tree.near(key, by, true, true)

  /// The entry with the least key at or after key.
  fn ceiling(key: K) -> (K, V)? = tree.near(key, by, false, true)

  /// The entry with the greatest key before key.
  fn lower(key: K) -> (K, V)? = tree.near(key, by, true, false)

  /// The entry with the least key after key.
  fn higher(key: K) -> (K, V)? = tree.near(key, by, false, false)

  /// The entries from the key from, with it, up to the key to, without
  /// it, in order, as a Seq: either left out, from the start or to the
  /// end. O(log n) to the first, then O(1) each (amortized).
  fn range(from: K? = none, to: K? = none) -> Seq<(K, V)> = mapWalk(tree, from, to, by)

  /// The entries in their keys' order, as a Seq.
  fn lazy() -> Seq<(K, V)> = mapWalk(tree, none, none, by)

  /// What for goes over: the (key, value) entries in order.
  fn iter() -> Seq<(K, V)> = lazy()

  /// The entries in order, in an array.
  fn entries() -> [(K, V)] = tree.entries(none, false, none, by, -1)

  /// The keys in order.
  fn keys() -> [K] = tree.keys(none, false, none, by, -1)

  /// The values, in their keys' order.
  fn values() -> [V] = tree.values(none, false, none, by, -1)
}

/// Elements kept in their order: a set whose elements are sorted, for
/// ranges, the least and the greatest, and the nearest to a value. They
/// are ordered by by, their own < unless it's given. insert, remove and
/// contains are O(log n).
///
///   var seen = SortedSet<int>()
///   seen.insert(30)
///   seen.insert(10)
///   seen.ceiling(15)                                // 30
pub struct SortedSet<T: Comparable> {
  /// The order, a less-than; none, the default, is the elements' own <.
  by: (fn(T, T) -> bool)? = none
  // The elements, in the runtime's B-tree (keys only).
  private tree: BTree<T, bool> = newSet<T>()

  /// The number of elements.
  fn count() -> int = tree.count()

  /// Whether there are none.
  fn isEmpty() -> bool = tree.count() == 0

  /// Whether x is an element: O(log n).
  fn contains(x: T) -> bool = tree.has(x, by)

  /// Adds x, in its place by the order: whether it's new. O(log n).
  mut fn insert(x: T) -> bool {
    return tree.add(x, by)
  }

  /// Removes x: whether it was an element. O(log n).
  mut fn remove(x: T) -> bool {
    return tree.delete(x, by)
  }

  /// Removes every element.
  mut fn clear() {
    tree = newSet<T>()
  }

  /// The least element, none when it's empty.
  fn first() -> T? = tree.endKey(false)

  /// The greatest element, none when it's empty.
  fn last() -> T? = tree.endKey(true)

  /// Removes and returns the least element.
  mut fn popFirst() -> T? {
    let x = first() else { return none }
    let _ = remove(x)
    return x
  }

  /// Removes and returns the greatest element.
  mut fn popLast() -> T? {
    let x = last() else { return none }
    let _ = remove(x)
    return x
  }

  /// The greatest element at or before x (by the order): x when it's one.
  fn floor(x: T) -> T? = tree.nearKey(x, by, true, true)

  /// The least element at or after x.
  fn ceiling(x: T) -> T? = tree.nearKey(x, by, false, true)

  /// The greatest element before x.
  fn lower(x: T) -> T? = tree.nearKey(x, by, true, false)

  /// The least element after x.
  fn higher(x: T) -> T? = tree.nearKey(x, by, false, false)

  /// The elements from from, with it, up to to, without it, in order, as
  /// a Seq: either left out, from the start or to the end.
  fn range(from: T? = none, to: T? = none) -> Seq<T> = setWalk(tree, from, to, by)

  /// The elements in order, as a Seq.
  fn lazy() -> Seq<T> = setWalk(tree, none, none, by)

  /// What for goes over: the elements in order.
  fn iter() -> Seq<T> = lazy()

  /// The elements in order, in an array.
  fn toArray() -> [T] = tree.keys(none, false, none, by, -1)

  /// The elements of both, in this set's order.
  fn union(other: SortedSet<T>) -> SortedSet<T> {
    var out = self
    for x in other.toArray() { let _ = out.insert(x) }
    return out
  }

  /// The elements other has too.
  fn intersection(other: SortedSet<T>) -> SortedSet<T> {
    var out = SortedSet<T>(by: by)
    for x in toArray() {
      if other.contains(x) { let _ = out.insert(x) }
    }
    return out
  }

  /// The elements other hasn't.
  fn subtracting(other: SortedSet<T>) -> SortedSet<T> {
    var out = self
    for x in other.toArray() { let _ = out.remove(x) }
    return out
  }
}

// ---- Equality, hashing, text and JSON ----
//
// A collection is equal to another of the same type with the same
// contents, whatever their orders (by), hashes by them, prints and is
// written as JSON as them: a Heap and a SortedSet as an array of their
// elements in their order, a SortedMap as an object when its keys are
// strings and as an array of {"key", "value"} objects when they aren't.
// Read back, a Heap and a SortedSet are ordered by their elements' own <,
// a SortedMap by its keys'.

extend<T: Hashable> Heap<T> {
  /// Whether other holds the same elements, as many times each,
  /// whatever its order: ==.
  pub fn equals(other: Heap<T>) -> bool = self.counts() == other.counts()

  /// What equal heaps hash alike by: their elements.
  pub fn hash() -> int = hashOf(self.counts())

  private fn counts() -> [T: int] {
    var c: [T: int] = [:]
    for x in items { c[x, default: 0] += 1 }
    return c
  }
}

extend<T> Heap<T> {
  /// Its elements in pop's order: how a heap is written as JSON, and
  /// printed.
  pub fn toJSON() -> [T] = sorted()
}

extend<T: Comparable> Heap<T> {
  /// A heap of json's elements, popping the least first by their own <:
  /// how json.decode reads one.
  pub static fn fromJSON(json: [T]) throws -> Heap<T> = Heap.min(json)
}

extend<K: Comparable & Hashable, V: Hashable> SortedMap<K, V> {
  /// Whether other has the same entries, whatever its order: ==.
  pub fn equals(other: SortedMap<K, V>) -> bool {
    if count() != other.count() { return false }
    for (k, v) in self {
      if other.get(k) != v { return false }
    }
    return true
  }

  /// What equal maps hash alike by: their entries.
  pub fn hash() -> int {
    var m: [K: V] = [:]
    for (k, v) in self { m[k] = v }
    return hashOf(m)
  }
}

extend<V> SortedMap<string, V> {
  /// Its entries as a JSON object, in its keys' order: how it's written
  /// and printed.
  pub fn toJSON() -> [string: V] {
    var m: [string: V] = [:]
    for (k, v) in self { m[k] = v }
    return m
  }

  /// A map of json's entries, ordered by its keys' own <.
  pub static fn fromJSON(json: [string: V]) throws -> SortedMap<string, V> {
    var m = SortedMap<string, V>()
    for (k, v) in json { m.set(k, v) }
    return m
  }
}

/// An entry of a SortedMap whose keys aren't strings, as JSON writes it.
pub struct Entry<K, V> {
  /// Its key.
  key: K
  /// Its value.
  value: V
}

extend<K: Comparable, V> SortedMap<K, V> {
  /// Its entries in its keys' order, as {"key", "value"} objects: how a
  /// map whose keys aren't strings is written as JSON, and printed.
  pub fn toJSON() -> [Entry<K, V>] = lazy().map(e => Entry(key: e.0, value: e.1)).toArray()

  /// A map of json's entries, ordered by its keys' own <.
  pub static fn fromJSON(json: [Entry<K, V>]) throws -> SortedMap<K, V> {
    var m = SortedMap<K, V>()
    for e in json { m.set(e.key, e.value) }
    return m
  }
}

extend<T: Comparable & Hashable> SortedSet<T> {
  /// Whether other has the same elements, whatever its order: ==.
  pub fn equals(other: SortedSet<T>) -> bool = count() == other.count() && toArray().all(x => other.contains(x))

  /// What equal sets hash alike by: their elements.
  pub fn hash() -> int = hashOf(Set(toArray()))
}

extend<T: Comparable> SortedSet<T> {
  /// Its elements in order: how it's written as JSON, and printed.
  pub fn toJSON() -> [T] = toArray()

  /// A set of json's elements, ordered by their own <.
  pub static fn fromJSON(json: [T]) throws -> SortedSet<T> {
    var s = SortedSet<T>()
    for x in json { let _ = s.insert(x) }
    return s
  }
}
