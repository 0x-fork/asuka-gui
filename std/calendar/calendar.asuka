// Package asuka/calendar is the user's calendars: EventKit on iOS and
// macOS, the Calendar Provider on Android. Adding an event shows the
// system's own form, which needs no access; reading needs it (request).
//
//   let saved = try await calendar.add(calendar.Event(title: "Demo", start: start, end: start + 30 * 60_000))

import asuka/platform
import asuka/json
import asuka/time

/// The app's access to the calendars.
pub enum Access {
  notAsked
  denied
  /// iOS 17: the app may add events, not read them.
  writeOnly
  full
}

/// A calendar.
pub struct Calendar {
  id: string = ""
  title: string = ""
  /// "#rrggbb".
  color: string = ""
  /// Its account ("iCloud", an address).
  source: string = ""
  writable: bool = false
}

/// An event, from start to end (asuka/time's Times);
/// an all-day event's are days, in UTC.
pub struct Event {
  id: string = ""
  calendarId: string = ""
  title: string = ""
  location: string = ""
  notes: string = ""
  url: string = ""
  start: time.Time = time.unix(0)
  end: time.Time = time.unix(0)
  allDay: bool = false
}

struct WireEvent {
  id: string = ""
  calendarId: string = ""
  title: string = ""
  location: string = ""
  notes: string = ""
  url: string = ""
  startMs: int = 0
  endMs: int = 0
  allDay: bool = false
}

fn notAllowed(e: Error) -> Error = if e.message == "not allowed" { Error("calendar: not allowed") } else { e }

/// Asks the user for access the first time, and answers what they allow.
pub async fn request() throws -> Access {
  let b = try await platform.call("calendar", "request", bytes())
  return match platform.readU8(b, 0) {
    1 => .denied
    2 => .writeOnly
    3 => .full
    _ => .notAsked
  }
}

/// The user's calendars (full access).
pub async fn calendars() throws -> [Calendar] {
  do {
    let b = try await platform.call("calendar", "calendars", bytes())
    return try json.decode(b.string())
  } catch e {
    throw notAllowed(e)
  }
}

struct Range {
  from: int
  to: int
  calendars: [string]
}

/// The events between from and to, of
/// calendars ([]: all), by their start (full access).
pub async fn events(from: time.Time, to: time.Time, calendars: [string] = []) throws -> [Event] {
  do {
    let b = try await platform.call("calendar", "events", json.encode(Range(from: from.unixMilli(), to: to.unixMilli(), calendars: calendars)).bytes())
    let ws: [WireEvent] = try json.decode(b.string())
    return ws.map(w => Event(id: w.id, calendarId: w.calendarId, title: w.title, location: w.location, notes: w.notes,
      url: w.url, start: time.unixMilli(w.startMs), end: time.unixMilli(w.endMs), allDay: w.allDay))
  } catch e {
    throw notAllowed(e)
  }
}

/// Shows the system's new event form with e filled in: whether the user
/// saved it.
pub async fn add(e: Event) throws -> bool {
  let w = WireEvent(title: e.title, location: e.location, notes: e.notes, url: e.url, calendarId: e.calendarId,
    startMs: e.start.unixMilli(), endMs: e.end.unixMilli(), allDay: e.allDay)
  do {
    let b = try await platform.call("calendar", "add", json.encode(w).bytes())
    return platform.readU8(b, 0) == 1
  } catch err {
    throw notAllowed(err)
  }
}
