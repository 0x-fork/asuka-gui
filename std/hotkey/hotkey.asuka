// Package asuka/hotkey is global shortcuts: keys that reach the app
// while another app is active (a launcher's ⌥Space). macOS:
// RegisterEventHotKey; Windows: RegisterHotKey; Linux: the
// GlobalShortcuts portal (the desktop asks the user, and shows the
// description), else X11's grab. A phone and the web have none: a Hotkey
// there says .notAvailable.
//
//   hotkey.Hotkey(Shortcut(key: "space", alt: true)) {
//     description: "Show the launcher"
//     on press { showLauncher() }
//     on error(e) { problem = e.message }
//   }

import asuka/platform

pub enum HotkeyError: Error {
  /// hotkey: the shortcut is taken
  taken
  /// hotkey: not allowed (the user said no, or the system doesn't let apps)
  notAllowed
  /// hotkey: not available here
  notAvailable
  /// hotkey: no such key
  noKey

  fn message() -> string = match self {
    .taken => "hotkey: the shortcut is taken"
    .notAllowed => "hotkey: not allowed"
    .notAvailable => "hotkey: not available here"
    .noKey => "hotkey: no such key"
  }
}

// The presses the host reports, by hotkey: one poll for every hotkey
// shown (the hosts answer one at a time), while any is.
state presses: [int: int] = [:]
state lastID = 0

fn polling() -> Stream<int> = Stream(send => {
  defer { platform.send("hotkey", "stop", bytes()) }
  var n = 0
  while true {
    let b = try await platform.call("hotkey", "next", bytes())
    var i = 0
    while i + 4 <= b.count() {
      let id = platform.readU32(b, i)
      presses[id] = (presses[id] ?? 0) + 1
      i += 4
    }
    n += 1
    send(n)
  }
})

let poll = live(0, polling)

fn errorOf(message: string) -> HotkeyError {
  if message == "taken" { return HotkeyError.taken }
  if message == "not allowed" { return HotkeyError.notAllowed }
  if message == "no key" { return HotkeyError.noKey }
  return HotkeyError.notAvailable
}

fn encode(id: int, s: Shortcut, description: string) -> bytes {
  // The prelude's Shortcut: its bools, and its mods.
  var mods = 0
  if s.primary || s.mods.contains(.primary) { mods += 1 }
  if s.shift || s.mods.contains(.shift) { mods += 2 }
  if s.alt || s.mods.contains(.alt) { mods += 4 }
  if s.control || s.mods.contains(.control) { mods += 8 }
  return platform.u32(id).concat(platform.u8(mods)).concat(platform.str(s.key.lower())).concat(description.bytes())
}

/// A global shortcut, registered while it's shown (a component that
/// shows nothing): press runs as its keys are pressed, error when it
/// can't be registered.
pub component Hotkey(shortcut: Shortcut) {
  prop description: string = ""
  event press
  event error(e: HotkeyError)

  state id = 0
  state seen = 0

  task(shortcut, description) {
    lastID += 1
    let mine = lastID
    do {
      let _ = try await platform.call("hotkey", "register", encode(mine, shortcut, description))
    } catch e {
      emit error(errorOf(e.message))
      return
    }
    defer { platform.send("hotkey", "unregister", platform.u32(mine)) }
    seen = presses[mine] ?? 0
    id = mine
    await never()
  }

  effect {
    let _ = poll()
    let n = presses[id] ?? 0
    if id != 0 && n > seen {
      seen = n
      emit press
    }
  }
}
