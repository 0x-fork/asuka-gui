// Package std/random has random numbers, choices and shuffles, from a
// fast generator each thread seeds from the system's randomness (not
// for secrets: std/crypto's randomBytes is).
//
//   let roll = random.int(1, 6)
//   let card = random.pick(deck)
//   random.seed(42) // the same numbers on every run, on this thread

/// A float from 0 up to (not including) 1.
pub native fn float() -> float

/// An int from min to max, both included (from max to min when max is
/// the smaller).
pub native fn int(min: int, max: int) -> int

/// true with the probability p (0 to 1).
pub fn chance(p: float) -> bool = float() < p

/// One of items, or none when there are none.
pub fn pick<T>(items: [T]) -> T? {
  if items.isEmpty() {
    return none
  }
  return items.get(int(0, items.count() - 1))
}

/// items in a random order (Fisher and Yates's shuffle).
pub fn shuffled<T>(items: [T]) -> [T] {
  var out = items
  var i = out.count() - 1
  while i > 0 {
    let j = int(0, i)
    let x = out[i]
    out[i] = out[j]
    out[j] = x
    i -= 1
  }
  return out
}

/// Makes this thread's numbers from now on the ones seed gives: the same
/// on every run.
pub native fn seed(seed: int)
