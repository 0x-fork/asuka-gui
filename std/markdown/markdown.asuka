// Package asuka/markdown shows Markdown (CommonMark, with GitHub's
// tables, task lists, strikethrough and autolinks) as the platform's own
// styled text: headings, emphasis, code, quotes, lists, tables and links
// in one selection, which the user's text size scales. Raw HTML in the
// text shows as text, and links open in the browser.
//
//   markdown.View(reply) { streaming: writing }
//
// A reply streaming in as a language model writes it: with streaming
// on, the end of the text shows what it will most likely become (a code
// fence closed, emphasis closed, a link being written as a link) rather
// than half-written syntax. Turn it off once the text is whole.
//
// Each platform's own Markdown reads it: Apple's (AttributedString) on
// iOS and macOS, Markwon on Android, marked on the web, and Asuka's
// parser (sdk/markdown/parser) on Windows (a rich edit) and Linux (a
// label's Pango markup).

/// Markdown, shown as styled text: as wide as its box, as tall as its
/// text.
pub component View(text: string) {
  /// The text is still being written: its end shows what it will most
  /// likely become.
  prop streaming = false

  Document(if streaming { heal(text) } else { text })
}

/// The platform's view of the Markdown.
native component Document(text: string) {}

/// What text being written will most likely become: a code fence it
/// opened closed, and in its last paragraph, the code, emphasis and
/// strikethrough it opened closed, and a link whose destination is being
/// written ended.
pub fn heal(text: string) -> string {
  let lines = text.split("\n")
  var fence = ""
  var last = 0 // where the last paragraph starts
  for (i, l) in lines.enumerated() {
    let t = l.trim()
    if fence.isEmpty() {
      if t.hasPrefix("```") || t.hasPrefix("~~~") {
        fence = t.slice(0, 3)
        continue
      }
      if t.isEmpty() { last = i + 1 }
    } else if t.hasPrefix(fence) {
      fence = ""
      last = i + 1
    }
  }
  if !fence.isEmpty() {
    return if text.hasSuffix("\n") { text + fence } else { text + "\n" + fence }
  }
  let cs = lines.slice(last, lines.count()).joined(separator: "\n").chars()
  var open: [string] = [] // the markers open, innermost last
  var code = false
  var dest = false // in a link's destination
  var lineStart = true
  var i = 0
  while i < cs.count() {
    let c = cs[i]
    if c == "\n" {
      lineStart = true
      i = i + 1
      continue
    }
    let atStart = lineStart
    if c != " " { lineStart = false }
    if c == "\\" {
      i = i + 2
      continue
    }
    if code {
      if c == "`" { code = false }
      i = i + 1
      continue
    }
    if dest {
      if c == ")" { dest = false }
      i = i + 1
      continue
    }
    if c == "`" {
      code = true
    } else if c == "]" && i + 1 < cs.count() && cs[i + 1] == "(" {
      dest = true
      i = i + 1
    } else if c == "*" || c == "_" || c == "~" {
      var n = 1
      while i + n < cs.count() && cs[i + n] == c { n = n + 1 }
      let next = cs.get(i + n) ?? " "
      let prev = if i > 0 { cs[i - 1] } else { " " }
      // A list's bullet, or an underscore inside a word: not a marker.
      let bullet = atStart && n == 1 && c != "~" && next == " "
      let inWord = c == "_" && wordy(prev) && wordy(next)
      if !bullet && !inWord {
        if c == "~" {
          if n >= 2 { open = toggled(open, "~~") }
        } else {
          if n >= 2 { open = toggled(open, c + c) }
          if n % 2 == 1 { open = toggled(open, c) }
        }
      }
      i = i + n
      continue
    }
    i = i + 1
  }
  var out = text
  if code { out = out + "`" }
  if dest { out = out + ")" }
  for m in open.reversed() { out = out + m }
  return out
}

/// The markers open after m: m closed when it's the innermost open, else
/// opened.
fn toggled(open: [string], m: string) -> [string] {
  var out = open
  if out.last() == m {
    out.pop()
  } else {
    out.push(m)
  }
  return out
}

/// A letter or a digit.
fn wordy(c: string) -> bool = c.lower() != c.upper() || "0123456789".contains(c)
