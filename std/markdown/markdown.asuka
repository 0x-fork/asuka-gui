// Package std/markdown shows Markdown (CommonMark, with GitHub's
// tables, task lists, strikethrough and autolinks) as the platform's own
// styled text: headings, emphasis, code, quotes, lists, tables and links
// in one selection, which the user's text size scales. Raw HTML in the
// text shows as text, and links open in the browser.
//
//   markdown.View(reply) { streaming: writing }
//
// A reply streaming in as a language model writes it: with streaming
// on, the end of the text shows what it will most likely become (a code
// fence closed, emphasis closed, a link being written as a link) rather
// than half-written syntax. Turn it off once the text is whole.
//
// The core reads the Markdown (md4c, the same on every platform) into
// paragraphs of styled runs; each platform shows them as its own styled
// text: an attributed string in a text view on iOS and macOS, spans in a
// TextView on Android, the DOM's elements on the web, a rich edit on
// Windows and a label's Pango markup on Linux.

import std/json

/// Markdown, shown as styled text: as wide as its box, as tall as its
/// text.
pub component View(text: string) {
  /// The text is still being written: its end shows what it will most
  /// likely become.
  prop streaming = false

  Document(paragraphs(if streaming { heal(text) } else { text }))
}

/// A paragraph's run of text in one style.
struct Run {
  text: string
  bold: bool = false
  italic: bool = false
  /// Code: monospaced.
  code: bool = false
  struck: bool = false
  /// In a quote: secondary text.
  quoted: bool = false
  /// Where it opens: a web, mail or phone address ("": not a link).
  link: string = ""
}

/// A block of the Markdown, as one paragraph of styled text.
struct Paragraph {
  runs: [Run]
  /// A heading's level, 1 to 6 (0: not a heading).
  heading: int = 0
  /// How deep in lists and quotes it is.
  indent: int = 0
  /// Its list item's marker ("•", "2.", "• ☑"; "": none), before its
  /// first line.
  marker: string = ""
  /// A code block: monospaced, on a background.
  code: bool = false
  /// A thematic break: a line across, no text.
  rule: bool = false
  /// A table's row: its cells' runs apart by tab runs.
  row: bool = false
  /// Close to the next (a tight list's item, a table's row).
  tight: bool = false
}

/// The paragraphs Markdown reads as (the core's, md4c).
fn paragraphs(text: string) -> [Paragraph] = (try? json.decode<[Paragraph]>(read(text))) ?? []

/// The platform's view of the paragraphs.
native component Document(paragraphs: [Paragraph]) {}

native fn read(text: string) -> string

/// What text being written will most likely become: a code fence it
/// opened closed, and in its last paragraph, the code, emphasis and
/// strikethrough it opened closed, and a link whose destination is being
/// written ended.
pub native fn heal(text: string) -> string
