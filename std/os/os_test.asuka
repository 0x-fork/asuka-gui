test "the process and the machine" {
  expect(!hostname().isEmpty())
  expect(pid() > 0)
  expect(ppid() > 0)
  expect(ppid() != pid())
  expect(platform() != .unknown)
  expect(arch() != .unknown)
  let u = user()
  expect(!u.name.isEmpty())
  expect(!u.home.isEmpty())
  if platform() == .windows {
    expect(u.uid == none)
  } else {
    expect((u.uid ?? -1) >= 0)
    expect((u.gid ?? -1) >= 0)
  }
}

test "the executable: an absolute path" {
  let path = executable() ?? ""
  expect(path.hasPrefix("/") || path.contains(":\\"))
}

test "the home is os.fake's HOME" {
  let _ = fake(env: ["HOME": "/home/ann", "USERPROFILE": "C:\\Users\\ann"])
  let home = user().home
  expect(home == "/home/ann" || home == "C:\\Users\\ann")
}

test "a fake doesn't change the process" {
  let before = (pid(), hostname(), user().name)
  let _ = fake(args: ["x"], env: [:])
  expect((pid(), hostname(), user().name) == before)
}

fn writes() {
  let out = writer(.stdout, size: 16)
  out.write("one ")
  print("printed")
  for i in 0..<3 {
    out.write("line {i}, longer than the buffer\n")
  }
  out.writeBytes("held\n".bytes())
  writeTo(.stderr, "to stderr\n")
}

test "a writer's output: in order with print, written out as main ends" {
  let o = fake()
  expect(await o.run(writes) == 0)
  expect(o.stdout() == "one printed\nline 0, longer than the buffer\nline 1, longer than the buffer\nline 2, longer than the buffer\nheld\n")
  expect(o.stderr() == "to stderr\n")
}
