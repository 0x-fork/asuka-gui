// syms.def: the functions of the system's libraries the host calls,
// SYM(library, result, name, parameters), resolved with dlsym (syms.c).
// The types are GTK's names (gtk.h declares them), so check_syms.c can
// compare these with the real headers.

// ---- GLib ----
SYM(GLIB, void, g_free, (gpointer mem))
SYM(GLIB, gchar *, g_strdup_printf, (const gchar *format, ...))
SYM(GLIB, const gchar *, g_get_home_dir, (void))
SYM(GLIB, gchar *, g_path_get_dirname, (const gchar *file_name))
SYM(GLIB, gint64, g_get_monotonic_time, (void))
SYM(GLIB, gint64, g_get_real_time, (void))
SYM(GLIB, guint, g_idle_add_full, (gint priority, GSourceFunc function, gpointer data, GDestroyNotify notify))
SYM(GLIB, guint, g_timeout_add, (guint interval, GSourceFunc function, gpointer data))
SYM(GLIB, gboolean, g_source_remove, (guint tag))
SYM(GLIB, GMainContext *, g_main_context_default, (void))
SYM(GLIB, gboolean, g_main_context_is_owner, (GMainContext *context))
SYM(GLIB, void, g_set_application_name, (const gchar *application_name))
SYM(GLIB, GDateTime *, g_date_time_new_local, (gint year, gint month, gint day, gint hour, gint minute, gdouble seconds))
SYM(GLIB, GDateTime *, g_date_time_new_from_unix_local, (gint64 t))
SYM(GLIB, void, g_date_time_unref, (GDateTime *datetime))
SYM(GLIB, gchar *, g_date_time_format, (GDateTime *datetime, const gchar *format))
SYM(GLIB, gint, g_date_time_get_year, (GDateTime *datetime))
SYM(GLIB, gint, g_date_time_get_month, (GDateTime *datetime))
SYM(GLIB, gint, g_date_time_get_day_of_month, (GDateTime *datetime))

