/// A counter.
/// It counts.
component Counter(
  start: int = 0, // where it starts
  step: int = 1,
) { // the body
  state count = start // the count

  // Derived.
  let doubled = count * 2

  Column {
    gap: 12; padding: 16
    Text("Count: {count}") { fontSize: 24 }
    Button("Add") { on tap { count += step } } // adds
    /* a block comment */
    if count > 10 &&
      count < 100 {
      Text("big")
    } else { Text("small") }
    // dangling at the end of the column
  }
  // dangling at the end of the body
}

