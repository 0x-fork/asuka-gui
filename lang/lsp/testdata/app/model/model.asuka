/// Something to do.
pub struct Todo {
  id: int
  /// What to do.
  title: string
  done: bool = false

  pub fn label() -> string = "#{id} {title}"
}

pub enum Filter { all, open, done }

/// Whether a todo shows under a filter.
pub fn matches(t: Todo, f: Filter) -> bool = match f {
  .all => true
  .open => !t.done
  .done => t.done
}
