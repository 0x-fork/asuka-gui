// async, await, try and throws.

async fn fetch() -> int {
  await sleep(10ms)
  return 1
}

fn mayFail() throws -> int { return 1 }

fn notAsync() -> int {
  return await fetch() // ERROR "await only where code may wait: mark notAsync async"
}

async fn forgot() -> int {
  return fetch() // ERROR "fetch is async: await it"
}

fn noTry() throws -> int {
  return mayFail() // ERROR "mayFail can throw: call it with try"
}

fn doesntThrow() -> int {
  return try mayFail() // ERROR "doesntThrow doesn't throw: mark it throws"
}

fn caught() -> int {
  do {
    return try mayFail()
  } catch {
    return 0
  }
}

fn optional() -> int {
  return try? mayFail() ?? 0
}

fn throwsWrong() throws {
  throw 3 // ERROR "throw takes an error, and an int isn't one"
}

struct State {
  n: int
}

state shared = 1

async fn spawns(cb: fn() -> int) -> int {
  let n = 3
  let t = spawn { n * 2 }
  let u = spawn { shared + 1 } // ERROR "spawn can't use shared: it's state"
  let v = spawn { cb() } // ERROR "spawn can't use cb"
  return await t
}

// A call that misses its try, in a function that can't throw: one error
// says both.
fn missesTry() -> int {
  let n = mightFail() // ERROR "mightFail can throw: call it with try \(try mightFail\(…\)\), or try\? for none on an error; and missesTry doesn't throw: mark it throws"
  return n
}

fn mightFail() throws -> int = 1

fn ticks() -> Stream<int> = Stream(send => { send(1) })

async fn readTicks() {
  for await n in ticks() { print("{n}") } // ERROR "a stream fails with what its block throws, and readTicks doesn't throw: mark it throws"
  for n in ticks() { } // ERROR "a stream's values come over time: for await x in it"
  for await n in [1, 2] { } // ERROR "for await goes over a stream, not a \[int\]"
}

async fn readTicksCaught() {
  do {
    for await n in ticks() { print("{n}") }
  } catch e {
    print(e.message)
  }
}
