// Sets: their elements are Hashable.

struct Point {
  x: int
}

enum Shape {
  dot(Point)
  none
}

// A struct, an enum and a tuple are when what they hold is.
fn points(s: Set<Point>, t: Set<Shape>, u: Set<(int, Shape?)>) -> bool = s.contains(Point(x: 1)) && t.contains(.dot(Point(x: 1))) && u.contains((1, none))

struct Spot {
  x: float
}

enum Mark {
  at(Spot)
  none
}

fn spots(s: Set<Spot>) {} // ERROR "a Set's element must be Hashable, and Spot isn't: its field x is a float, and floats aren't \(NaN isn't equal to itself\)"

fn marks(s: Set<Mark>) {} // ERROR "a Set's element must be Hashable, and Mark isn't: its case at holds a Spot, and its field x is a float"

fn pairs(s: Set<(int, float)>) {} // ERROR "a Set's element must be Hashable, and \(int, float\) isn't: it holds a float"

fn arrays(s: Set<[int]>) {} // ERROR "a Set's element must be Hashable, and \[int\] isn't: arrays aren't"

// Its fields are read after the declarations that name it.
fn later(m: [Late: int]) {} // ERROR "a map's key must be Hashable, and Late isn't: its field f is a fn\(\) -> int, and functions aren't"

struct Late {
  f: fn() -> int
}

// One that holds itself is when the rest is.
struct Chain {
  id: int
  next: Chain?
}

fn chains(s: Set<Chain>, m: [Chain: string]) -> int = s.count() + m.count()

struct BadChain {
  next: BadChain?
  w: float
}

fn badChains(s: Set<BadChain>) {} // ERROR "its field w is a float"

fn generic<T: Hashable>(x: T) -> Set<T> = [x]

fn usesGeneric() {
  let a = generic(Point(x: 1))
  let b = generic(Spot(x: 1)) // ERROR "generic's T must be Hashable, and Spot isn't: its field x is a float"
}

fn twoTypes() -> Set<int, string> = [] // ERROR "Set takes one type: Set<T>"

fn literal() -> Set<int> = [1, "a"] // ERROR "an element of Set<int> is a string, not an int"

fn fromWhat() -> Set<int> = Set(3) // ERROR "Set\\(…\\)'s argument is an int, not a \\[int\\]"

fn fromNothing() {
  let s = Set() // ERROR "can't tell the set's elements: Set<T>\(\), or say what's expected"
}

fn wrongElement(s: Set<string>) -> bool = s.contains(1) // ERROR "is an int, not a string"

fn noIndex(s: Set<int>) -> int = s[0] // ERROR "a Set<int> can't be indexed"

fn ordered(s: Set<int>) -> bool = s < s // ERROR "Set<int> can't be ordered with <: ints, floats"

fn setOfSets(s: Set<Set<int>>) {} // ERROR "a Set's element must be Hashable, and Set<int> isn't: sets aren't"

fn ok(s: Set<string>) -> Set<string> {
  var t = s
  t.insert("x")
  for x in s {
    t.remove(x)
  }
  return t.union(["a"]).intersection(s).subtracting([])
}

fn noUpdate(s: Set<int>) {
  s.insert(1) // ERROR "s"
}

struct Handler {
  run: fn() -> int
}

fn sameHandler(a: Handler, b: Handler) -> bool = a == b // ERROR "Handler can't be compared with ==: its field run is a fn\(\) -> int, and functions can't be"
fn knownHandler(hs: [Handler], h: Handler) -> bool = hs.contains(h) // ERROR "contains compares elements, and Handler can't be compared: its field run"
