// An if or a match that ends a value block is its value: each branch
// has one.

fn arms(b: bool) -> int {
  var x = 0
  let y = if b {
    match b {
      true => 1
      false => x = 2 // ERROR "this arm has no value: make it an expression"
    }
  } else {
    0
  }
  return y + x
}

fn mixed(b: bool) -> int {
  let y = if b { if b { 1 } else { "s" } } else { 0 } // ERROR "the branches are an int and a string"
  return 0
}

fn noElse(b: bool) -> int = if b { if b { 1 } } else { 0 } // ERROR "an if used as a value needs an else"

fn noElseIf(b: bool) -> int = if b {
  if b { 1 } else if !b { 2 } // ERROR "an if used as a value needs an else"
} else {
  0
}

fn caught(s: string) throws -> int = try s.toInt() ?? throw Error("x")

fn fallback(s: string, b: bool) -> int = try caught(s) catch {
  if b { 1 } // ERROR "an if used as a value needs an else"
}
