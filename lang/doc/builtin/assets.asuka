// Package std/assets reads a file of the package's assets/ directory as
// the app compiles, as Go's go:embed does: every platform has it, with
// nothing to load as the app runs.
//
//   let welcome = assets.text("welcome.md")
//   let logo = assets.bytes("logo.png")
//
// The path is a string literal, relative to assets/, inside it. A file
// that isn't there is a compile error.

/// The text of assets/path (UTF-8).
pub native fn text(path: string) -> string
/// The bytes of assets/path.
pub native fn bytes(path: string) -> bytes
