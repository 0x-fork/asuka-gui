// 1.5 0.10000000149011612 0x8000000000000000 1.401298464324817e-45
// true true true
// 0x3ff0000000000000 0xc004000000000000 0x3fb999999999999a 0x8000000000000000 0x7ff0000000000000
// 0.1 3.141592653589793 5e-324
// little: 0000c03f cdcccc3d 9a9999999999b93f 0000000000000080
// little: 0.10000000149011612 0.1 1.5
// big: 3fc00000 3dcccccd 3fb999999999999a 8000000000000000
// big: 0.10000000149011612 0.1 1.5
// readF64 at 1: encoding: readF64 needs 8 bytes at 1, and the data has 8
// ok floats
// 0: 00 true 1
// 1: 01 true 1
// 2: 02 true 1
// 127: 7f true 1
// 128: 8001 true 2
// 255: ff01 true 2
// 256: 8002 true 2
// 300: ac02 true 2
// 16383: ff7f true 2
// 16384: 808001 true 3
// 4294967296: 8080808010 true 5
// 9223372036854775808: 80808080808080808001 true 10
// 18446744073709551615: ffffffffffffffffff01 true 10
// 0: 00 true 1
// -1: 01 true 1
// 1: 02 true 1
// -2: 03 true 1
// 2: 04 true 1
// 63: 7e true 1
// -64: 7f true 1
// 64: 8001 true 2
// -65: 8101 true 2
// 300: d804 true 2
// -300: d704 true 2
// 9223372036854775807: feffffffffffffffff01 true 10
// -9223372036854775808: ffffffffffffffffff01 true 10
// 300 -3 5 4 4
// 0 2
// truncated: encoding: readUvarint at 0: the data (1 byte) ends inside the varint
// truncated 2: encoding: readUvarint at 0: the data (2 bytes) ends inside the varint
// empty: encoding: readUvarint needs 1 byte at 0, and the data has 0
// 10th byte 2: encoding: readUvarint at 0: the varint is past 64 bits
// 11 bytes: encoding: readUvarint at 0: the varint is past 64 bits
// 10th byte 1: 18446744073709551615 10
// at -1: encoding: readVarint at -1: an offset can't be negative
// at 1: encoding: readVarint needs 1 byte at 1, and the data has 1
// signed past 64 bits: encoding: readVarint at 0: the varint is past 64 bits
// ok varints
// big: 47 47 abff0102fffedeadbeeffffffffdffffffffffffffff80000000000000003fc00000bfd0000000000000ac02056f6b
// 171 -1 258 -2 3735928559 -3 18446744073709551615 -9223372036854775808 1.5 -0.25 300 -3 ok
// 47 0 true
// encoding: Reader.u32 needs 4 bytes at 47, and the data has 47; offset 47
// little: 47 47 abff0201feffefbeaddefdffffffffffffffffffffff00000000000000800000c03f000000000000d0bfac02056f6b
// 171 -1 258 -2 3735928559 -3 18446744073709551615 -9223372036854775808 1.5 -0.25 300 -3 ok
// 47 0 true
// encoding: Reader.u32 needs 4 bytes at 47, and the data has 47; offset 47
// 515 3 3 false
// encoding: Reader.u32 needs 4 bytes at 3, and the data has 6; offset 3
// encoding: Reader.bytes needs 4 bytes at 3, and the data has 6; offset 3
// encoding: Reader.skip needs 4 bytes at 3, and the data has 6; offset 3
// encoding: Reader.bytes of -1 bytes: a count can't be negative; offset 3
// encoding: Reader.uvarint at 5: the data (6 bytes) ends inside the varint; offset 5
// encoding: Reader.i64 needs 8 bytes at 5, and the data has 6; offset 5
// 6 0 true
// 1 2 false
// 0 0
// ok reader and writer
// : |||
// true
// f: MY======|MY|CO======|CO
// true
// fo: MZXQ====|MZXQ|CPNG====|CPNG
// true
// foo: MZXW6===|MZXW6|CPNMU===|CPNMU
// true
// foob: MZXW6YQ=|MZXW6YQ|CPNMUOG=|CPNMUOG
// true
// fooba: MZXW6YTB|MZXW6YTB|CPNMUOJ1|CPNMUOJ1
// true
// foobar: MZXW6YTBOI======|MZXW6YTBOI|CPNMUOJ1E8======|CPNMUOJ1E8
// true
// 77XN3TF3VI======
// ffeeddccbbaa
// foobar
// f
// MY=====: base32: the padding at 2 doesn't fill the last group to 8 digits
// MY=======: base32: the padding at 2 doesn't fill the last group to 8 digits
// M: base32: the data ends in the middle of a byte
// MZXW6Y: base32: the data ends in the middle of a byte
// MZX: base32: the data ends in the middle of a byte
// MY======MY: base32: data after the padding at 8
// ========: base32: the padding at 0 doesn't fill the last group to 8 digits
// MZXW6YTB========: base32: the padding at 8 doesn't fill the last group to 8 digits
// M1: base32: '1' (at 1) isn't base32
// CW: base32: 'W' (at 1) isn't base32 (the hex alphabet)
// MZXW6YT!: base32: '!' (at 7) isn't base32
// ok base32
// big A: 0041 true true
// big é: 00e9 true true
// big €: 20ac true true
// big 😀: d83dde00 true true
// big a€😀z: 006120acd83dde00007a true true
// big :  true true
// big BOM: feff00680069d83dde00 hi😀 hi😀 3
// little A: 4100 true true
// little é: e900 true true
// little €: ac20 true true
// little 😀: 3dd800de true true
// little a€😀z: 6100ac203dd800de7a00 true true
// little :  true true
// little BOM: fffe680069003dd800de hi😀 hi😀 3
// A
// A
// 2
// 0
// lone high: �A 2
// lone high strictly: encoding: utf16DecodeStrict: an unpaired surrogate (0xd83d) at byte 0
// lone low: A� 2
// lone low strictly: encoding: utf16DecodeStrict: an unpaired surrogate (0xde00) at byte 2
// high at the end: A� 2
// high at the end strictly: encoding: utf16DecodeStrict: an unpaired surrogate (0xd83d) at byte 2
// two highs: �😀 2
// two highs strictly: encoding: utf16DecodeStrict: an unpaired surrogate (0xd83d) at byte 0
// odd: A� 2
// odd strictly: encoding: utf16DecodeStrict: an odd number of bytes (3): the last, at 2, is half a code unit
// one byte: � 1
// one byte strictly: encoding: utf16DecodeStrict: an odd number of bytes (1): the last, at 0, is half a code unit
// high, then odd: � 1
// high, then odd strictly: encoding: utf16DecodeStrict: an unpaired surrogate (0xd83d) at byte 0
// little lone low strictly: encoding: utf16DecodeStrict: an unpaired surrogate (0xdc00) at byte 4
// ok utf16
