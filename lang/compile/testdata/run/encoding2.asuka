// big: 258 -2 -32768
// big: 16909060 4294868992 -98304
// big: 72623859790382856 361984555285905408 361984555285905408
// big: true -1 -9223372036854775808
// big: 0102 fffe deadbeef 80000000
// big: ffffffffffffffff 0102030405060708 8000000000000000 fffffffffffffffe
// big: -32768 4294967295 true
// ff 80 ff 00
// readU32 at 10: encoding: readU32 needs 4 bytes at 10, and the data has 12
// readU32 at -1: encoding: readU32 at -1: an offset can't be negative
// readU8 at 12: encoding: readU8 needs 1 byte at 12, and the data has 12
// readU8 at 11: 0
// readI64 of none: encoding: readI64 needs 8 bytes at 0, and the data has 0
// readU16 at 11: encoding: readU16 needs 2 bytes at 11, and the data has 12
// readU16 far: encoding: readU16 needs 2 bytes at 9223372036854775807, and the data has 12
// ok fixed widths
// 0x3fc00000
// 0x80000000
// 0x3f800000
// 0xc0000000
// 0x3dcccccd
// 0x4b800000
// 0x7f800000
// 0xff800000
