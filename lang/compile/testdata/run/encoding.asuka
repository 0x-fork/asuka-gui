// asuka/encoding, asuka/crypto and asuka/html: known answers.

import asuka/encoding
import asuka/crypto
import asuka/html

test "base64 and hex" {
  for s in ["", "f", "fo", "foo", "foob", "fooba", "foobar"] {
    let b64 = encoding.base64Encode(s.bytes())
    print("{s}: {b64}|{encoding.base64URLEncode(s.bytes())}|{encoding.hexEncode(s.bytes())}")
    print((try encoding.base64Decode(b64)).string() == s)
  }
  print(encoding.base64Encode("\u{fb}\u{ff}".bytes()))
  print(encoding.base64URLEncode("\u{fb}\u{ff}".bytes()))
  print((try encoding.base64Decode("w7vDvw")).string())
  print((try encoding.base64Decode("Zm9v\nYmFy")).string())
  print((try encoding.hexDecode("DEADbeef")).count())
  for bad in ["Zm9v!", "Zm9vY", "Zg=a"] {
    do {
      let b = try encoding.base64Decode(bad)
      print("decoded {b.count()}")
    } catch e {
      print(e.message)
    }
  }
  for bad in ["abc", "zz"] {
    do {
      let b = try encoding.hexDecode(bad)
      print("decoded {b.count()}")
    } catch e {
      print(e.message)
    }
  }
}

test "hashes" {
  print(encoding.hexEncode(crypto.sha256(bytes())))
  print(encoding.hexEncode(crypto.sha256("abc".bytes())))
  print(encoding.hexEncode(crypto.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes())))
  print(encoding.hexEncode(crypto.sha256("a".repeat(1000).bytes())))
  print(encoding.hexEncode(crypto.sha1("abc".bytes())))
  print(encoding.hexEncode(crypto.sha1(bytes())))
  // RFC 4231, test cases 1 and 2.
  print(encoding.hexEncode(crypto.hmacSHA256(key: try encoding.hexDecode("0b".repeat(20)), data: "Hi There".bytes())))
  print(encoding.hexEncode(crypto.hmacSHA256(key: "Jefe".bytes(), data: "what do ya want for nothing?".bytes())))
  // A key longer than a block is hashed first (test case 6).
  print(encoding.hexEncode(crypto.hmacSHA256(key: try encoding.hexDecode("aa".repeat(131)), data: "Test Using Larger Than Block-Size Key - Hash Key First".bytes())))
  print(crypto.equal("abc".bytes(), "abc".bytes()))
  print(crypto.equal("abc".bytes(), "abd".bytes()))
  print(crypto.equal("abc".bytes(), "ab".bytes()))
}

test "randomness" {
  let a = crypto.randomBytes(32)
  print(a.count())
  print(crypto.equal(a, crypto.randomBytes(32)))
  print(crypto.randomBytes(0).count())
  let id = crypto.uuid()
  print(id.count())
  print(id.slice(14, 15))
  print("89ab".contains(id.slice(19, 20)))
  print(id != crypto.uuid())
}

test "html" {
  print(html.escape("<a href=\"x\">Tom & Jerry's</a>"))
  print(html.escape("plain"))
  print(html.unescape("&lt;p&gt;Fish &amp; Chips &copy; 2026 &mdash; &#169; &#xA9; &eacute;&hellip; &bogus; &amp &#0; &#x1F600;"))
  print(html.unescape(html.escape("<\"'&>")))
}

