let serverKey = "-----BEGIN ENCRYPTED PRIVATE KEY-----\nMIH0MF8GCSqGSIb3DQEFDTBSMDEGCSqGSIb3DQEFDDAkBBBXJ6a58jHt1zfVRgUw\n1D8eAgIIADAMBggqhkiG9w0CCQUAMB0GCWCGSAFlAwQBKgQQF6z/SR0vZKqcgW0C\nj/aupgSBkObvjk0N3t52nTawADvPmnfFOatdYkC2QPLS0+Vcv4tp3gM0N3+Z11FY\nR0L5fxNFLT2ZKHyUL4NatyDoe1J9L0vjQMJLihr4OIZN55hJG1zxmo/RTO0iK0WJ\nU7MfP5y4a59BFvSvklrhaPfy/bu+qlOxmx2mSyItKOUc4hNBq0FMFrUP9P42Q5mT\nxY2Np7zx6A==\n-----END ENCRYPTED PRIVATE KEY-----\n"
