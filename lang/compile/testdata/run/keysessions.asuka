test "encrypted keys" {
  let key = try await crypto.decryptPrivateKey(sshKey, password: "asuka")
  print("{key.kind == crypto.KeyKind.ed25519} {key.bits}")
  do {
    let _ = try await crypto.decryptPrivateKey(sshKey, password: "nope")
  } catch crypto.CryptoError.wrongPassword {
    print("wrong password")
  }
  let tlsKey = try await crypto.decryptPrivateKey(serverKey, password: "asuka")
  let text = await tlsKey.encryptedPEM(password: "another")
  print(text.hasPrefix("-----BEGIN ENCRYPTED PRIVATE KEY-----\n"))
  print((try await crypto.decryptPrivateKey(text, password: "another")) == tlsKey)
  print((try? crypto.privateKey(text)) == none)
}

async fn get(port: int, tls: net.ClientTLS) throws -> string {
  let c = try await net.connectTLS("localhost", port, tls: tls)
  let state = try await c.handshake()
  try await c.write("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
  let reply = (try await c.readAll()).string()
  c.close()
  return "{state.version == net.TLSVersion.tls13} resumed {state.resumed} {state.peerCertificates.count()} {reply.hasSuffix("hi")}"
}

test "sessions resumed" {
  let key = (try await crypto.decryptPrivateKey(serverKey, password: "asuka")).pem()
  let tls = try net.serverTLS(certificate: serverCert, key: key)
  let server = try await http.serve(0, req => .text("hi"), tls: tls)
  let v13 = try net.clientTLS(ca: caCert, sessionCache: 3)
  let v12 = try net.clientTLS(ca: caCert, maxVersion: .tls12, sessionCache: 3)
  let keepsNone = try net.clientTLS(ca: caCert, sessionCache: 0)
  for t in [v13, v13, v12, v12, keepsNone, keepsNone] {
    print(try await get(server.port, t))
  }
  await server.close()
}

// Output:
// true 256
// wrong password
// true
// true
// true
// ok encrypted keys
// true resumed false 2 true
// true resumed true 2 true
// false resumed false 2 true
// false resumed true 2 true
// true resumed false 2 true
// true resumed false 2 true
// ok sessions resumed
