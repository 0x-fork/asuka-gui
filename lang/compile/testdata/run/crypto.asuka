fn checkJWS(token: string, key: crypto.PublicKey) throws -> bool {
  let parts = token.split(".")
  let header = (try encoding.base64Decode(parts[0])).string()
  let alg = if header.contains("RS256") { "RS256" } else { "ES256" }
  let scheme = crypto.SignatureScheme.jws(alg) ?? .ed25519
  return try crypto.verify(key, "{parts[0]}.{parts[1]}".bytes(), try encoding.base64Decode(parts[2]), scheme: scheme)
}

test "signatures" {
  let rsa = try crypto.publicKeyFromJWK(rsaJWK)
  print("{rsa.kind} {rsa.bits} {try checkJWS(rsaJWS, rsa)}")
  let priv = try crypto.privateKeyFromJWK(rsaJWK)
  let parts = rsaJWS.split(".")
  print(encoding.base64URLEncode(try crypto.sign(priv, "{parts[0]}.{parts[1]}".bytes(), scheme: .rsaPKCS1v15(.sha256))) == parts[2])
  print(rsa.pem().split("\n")[0])
  let ec = try crypto.publicKeyFromJWK(ecJWK)
  print("{ec.kind} {ec.bits} {try checkJWS(ecJWS, ec)} {try checkJWS(ecJWS.replace(".eyJ", ".eyK"), ec)}")
  print(try ec.jwk())
  // RFC 6979: ECDSA signs the same message the same.
  let ecPriv = try crypto.privateKeyFromJWK(ecJWK)
  let s1 = try crypto.sign(ecPriv, "sample".bytes(), scheme: .ecdsa(.sha256))
  print(s1 == try crypto.sign(ecPriv, "sample".bytes(), scheme: .ecdsa(.sha256)))
  print(try crypto.verify(ec, "sample".bytes(), s1, scheme: .ecdsa(.sha256)))
  print(try crypto.verify(ec, "sample".bytes(), try crypto.sign(ecPriv, "sample".bytes(), scheme: .ecdsaDER(.sha512)), scheme: .ecdsaDER(.sha512)))
  for kind in [crypto.KeyKind.ecdsaP384, .ed25519] {
    let key = try crypto.newPrivateKey(kind: kind)
    let scheme = if kind == .ed25519 { crypto.SignatureScheme.ed25519 } else { crypto.SignatureScheme.ecdsa(.sha384) }
    let sig = try crypto.sign(key, "m".bytes(), scheme: scheme)
    let back = try crypto.publicKey((try key.publicKey()).pem())
    print("{kind} {sig.count()} {try crypto.verify(back, "m".bytes(), sig, scheme: scheme)}")
  }
  do {
    let _ = try crypto.verify(ec, "m".bytes(), s1, scheme: .rsaPSS(.sha256))
  } catch e {
    print(e.message)
  }
}

