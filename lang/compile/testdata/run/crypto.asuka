// std/crypto beyond hashes: HMAC-SHA512, HKDF, PBKDF2, authenticated
// encryption, password hashing and signatures, known answers (RFC 4231,
// 5869, 7914, 8439, 9106's parameters through Go's x/crypto, 7515's
// JWS), the same on the VM and compiled to C.

import std/crypto
import std/encoding

fn hex(s: string) -> bytes = (try? encoding.hexDecode(s)) ?? bytes()

test "MACs and key derivation" {
  print(crypto.hmacSHA512("Jefe".bytes(), "what do ya want for nothing?".bytes()).hex().slice(0, 32))
  print(crypto.hmac("Jefe".bytes(), "what do ya want for nothing?".bytes(), hash: .sha384).hex().slice(0, 32))
  print((try crypto.hkdf(hex("0b".repeat(22)), salt: hex("000102030405060708090a0b0c"), info: hex("f0f1f2f3f4f5f6f7f8f9"), length: 42)).hex())
  print((try crypto.pbkdf2("passwd".bytes(), salt: "salt".bytes(), iterations: 1, length: 16)).hex())
  print(crypto.md5("abc".bytes()).hex())
  print(crypto.sha384(bytes()).hex().slice(0, 32))
  do {
    let _ = try crypto.hkdf(bytes(), length: 9000)
  } catch e {
    print(e.message)
  }
}

test "authenticated encryption" {
  let key = hex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
  let plain = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".bytes()
  let ad = hex("50515253c0c1c2c3c4c5c6c7")
  let sealed = try crypto.sealWithNonce(key, nonce: hex("070000004041424344454647"), plaintext: plain, additionalData: ad, cipher: .chaCha20Poly1305)
  print(sealed.slice(0, 16).hex())
  print(sealed.slice(sealed.count() - 16, sealed.count()).hex())
  let x = try crypto.sealWithNonce(key, nonce: hex("404142434445464748494a4b4c4d4e4f5051525354555657"), plaintext: plain, additionalData: ad)
  print(x.slice(x.count() - 16, x.count()).hex())
  let g = try crypto.sealWithNonce(hex("feffe9928665731c6d6a8f9467308308"), nonce: hex("cafebabefacedbaddecaf888"), plaintext: bytes(), cipher: .aes128GCM)
  print(g.hex())
  for c in [crypto.Cipher.xChaCha20Poly1305, .chaCha20Poly1305, .aes256GCM, .aes128GCM] {
    let k = crypto.newKey(cipher: c)
    let s = try crypto.seal(k, "hi".bytes(), additionalData: "id".bytes(), cipher: c)
    print("{s.count()} {(try crypto.open(k, s, additionalData: "id".bytes(), cipher: c)).string()}")
    do {
      let _ = try crypto.open(k, s, cipher: c)
    } catch e {
      print(e.message)
    }
  }
  do {
    let _ = try crypto.seal(bytes(), plain, cipher: .aes256GCM)
  } catch e {
    print(e.message)
  }
}

test "passwords" {
  let k = try await crypto.argon2id("password".bytes(), salt: "somesaltsomesalt".bytes(), memory: 256, iterations: 2, parallelism: 1)
  print(k.hex())
  print(try await crypto.verifyPassword("password", hash: "$argon2id$v=19$m=256,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$yrdGtGIZk/3JHsUHh5gLQUqQppLwvGjf4Z+cJbPLqew"))
  print(try await crypto.verifyPassword("U*U", hash: "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"))
  print(try await crypto.verifyPassword("U*V", hash: "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"))
  let h = try await crypto.hashPassword("hunter2", memory: 64, iterations: 1, parallelism: 1)
  print("{h.slice(0, 28)} {try await crypto.verifyPassword("hunter2", hash: h)}")
  let b = try await crypto.hashPasswordBcrypt("hunter2", cost: 4)
  print("{b.slice(0, 7)} {b.count()} {try await crypto.verifyPassword("hunter2", hash: b)}")
  do {
    let _ = try await crypto.hashPasswordBcrypt("x".repeat(80))
  } catch e {
    print(e.message)
  }
}

