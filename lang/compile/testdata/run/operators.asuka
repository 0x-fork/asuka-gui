// A struct's or an enum's operators from its methods: * from mul (or
// times), / from div (or quo), % from rem, -x from neg, beside + from
// add, - from sub (or minus); the operand's type may differ from the
// value's, and x *= y, /=, %= use them as += uses add.

struct Vec {
  x: int
  y: int

  fn add(o: Vec) -> Vec = Vec(x: x + o.x, y: y + o.y)
  // The dot product; a Vec scaled by an int.
  fn mul(o: Vec) -> int = x * o.x + y * o.y
  fn times(k: int) -> Vec = Vec(x: x * k, y: y * k)
  fn div(k: int) -> Vec = Vec(x: x / k, y: y / k)
  fn rem(k: int) -> Vec = Vec(x: x % k, y: y % k)
  fn neg() -> Vec = Vec(x: -x, y: -y)
}

enum Sign {
  plus
  minus

  fn neg() -> Sign = match self {
    .plus => .minus
    .minus => .plus
  }
  fn mul(o: Sign) -> Sign = if self == o { .plus } else { .minus }
}

struct Ratio {
  n: int
  d: int

  fn div(o: Ratio) -> Ratio = Ratio(n: n * o.d, d: d * o.n)
  fn quo(k: int) -> Ratio = Ratio(n: n, d: d * k)
}

struct Grid {
  at: Vec
  path: [Vec]
}

state pos = Vec(x: 6, y: 9)

test "binary and unary" {
  let a = Vec(x: 3, y: 4)
  print(a * a)
  print(a * 2)
  print(a / 2)
  print(a % 2)
  print(-a)
  print(-(a + a) * 3)
  print(-Sign.plus)
  print(Sign.minus * Sign.minus)
  print(Sign.minus * -Sign.minus)
  let r = Ratio(n: 1, d: 2) / Ratio(n: 3, d: 4)
  print("{r.n}/{r.d}")
  let h = r / 2
  print("{h.n}/{h.d}")
}

test "compound assignment" {
  var v = Vec(x: 5, y: 7)
  v *= 10
  print(v)
  v /= 3
  print(v)
  v %= 4
  print(v)
  var g = Grid(at: Vec(x: 1, y: 2), path: [Vec(x: 1, y: 1), Vec(x: 2, y: 3)])
  g.at *= 3
  g.path[1] /= 2
  print(g)
  pos %= 4
  print(pos)
  var r = Ratio(n: 1, d: 2)
  r /= 5
  print("{r.n}/{r.d}")
}

// Output:
// 25
// {"x":6,"y":8}
// {"x":1,"y":2}
// {"x":1,"y":0}
// {"x":-3,"y":-4}
// {"x":-18,"y":-24}
// minus
// plus
// minus
// 4/6
