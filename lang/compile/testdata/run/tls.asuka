let serverKey = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgDxk5TysBt5+tdBFg\n/f8DWRlU84ugOLyGjiRrE7wA74OhRANCAAT8n7JgII+lWmm1hpeJdP8cKe2M2QM/\nt7sbc9BLpim0fg8BuIwar8tNzvo+uM1E9EB8Aywf6BbZe9755I6188Wu\n-----END PRIVATE KEY-----\n"

test "a TLS echo" {
  let tls = try net.serverTLS(certificate: serverCert, key: serverKey, alpn: ["echo/1"])
  let server = try await net.serve(0, c => {
    for await line in c.lines() {
      try await c.write("{line.upper()}\n")
    }
  }, tls: tls)
  let c = try await net.connectTLS("localhost", server.port, tls: try net.clientTLS(ca: caCert, alpn: ["echo/1"]))
  let st = try await c.handshake()
  print("{st.version == net.TLSVersion.tls13} {st.protocol} {st.serverName} {st.peerCertificates.count()}")
  try await c.write("hello\nsecure world\n")
  print(try await c.readLine())
  print(try await c.readLine())
  c.close()
  do {
    let _ = try await net.connectTLS("localhost", server.port, tls: try net.clientTLS(ca: caCert), serverName: "elsewhere.example")
  } catch net.NetError.untrustedCertificate(problem, reason) {
    print("{problem == net.CertificateProblem.wrongHost}: {reason}")
  }
  await server.close()
}

test "HTTPS" {
  let tls = try net.serverTLS(certificate: serverCert, key: serverKey)
  let server = try await http.serve(0, req => .text("hello over {req.method} {req.path}"), tls: tls)
  print(server.url.hasPrefix("https://127.0.0.1:"))
  let c = try await net.connectTLS("localhost", server.port, tls: try net.clientTLS(ca: caCert))
  try await c.write("GET /tls HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
  let reply = (try await c.readAll()).string()
  print("{reply.hasPrefix("HTTP/1.1 200 OK\r\n")} {reply.hasSuffix("hello over GET /tls")}")
  let dir = fs.join([fs.tempDir(), "asuka-tls-test-{random.int(0, 1000000000)}"])
  try await spawn { try fs.mkdirAll(dir) }
  defer {
    try? await spawn { try fs.removeAll(dir) }
  }
  let ca = fs.join([dir, "ca.pem"])
  try await spawn { try fs.writeText(ca, caCert) }
  let out = try await command.run("curl", ["-s", "-S", "--no-progress-meter", "--cacert", ca, "https://localhost:{server.port}/curl"])
  print(out.text())
  await server.close()
}

// Output:
// true echo/1 localhost 2
// HELLO
// SECURE WORLD
// true: elsewhere.example's certificate is for localhost, test.example, 127.0.0.1, ::1, not elsewhere.example
// ok a TLS echo
// true
// true true
// hello over GET /curl
// ok HTTPS
