// asuka/integrity with no platform code (the fake host): no attestation,
// as on Windows, Linux and the web.

import asuka/integrity

test "no attestation here" {
  print(integrity.supported())
  do {
    let key = try await integrity.generateKey()
    print(key)
  } catch e {
    print(e.message)
  }
}

// Output:
// false
// unsupported: no app attestation here
// ok no attestation here
