// args: --job 3
// exit: 2
import asuka/flag
import asuka/os

struct Options {
  jobs: int = 4
}

fn main() {
  let o = flag.parse<Options>(os.args())
  print(o.jobs)
}

// Stdout:
// Stderr:
// error: unknown option --job (did you mean --jobs?)
//
// Usage: prog [options]
//
// For more, try 'prog --help'.
