// A shader declaration: its parameters its uniforms, used as a view.

/// A band of light that flows across a night sky, greener as level
/// rises.
shader Aurora(level: float, tint: Color = #33ccaa) {
  let speed = 0.4

  fn wave(x: float, t: float) -> float = sin(x * 6 + t) * 0.5 + sin(x * 11 - t * 1.3) * 0.25

  fn fragment(pos: vec2) -> vec4 {
    let uv = pos / size
    let t = time * speed
    let band = smoothstep(0.35, 0, abs(uv.y - 0.5 - wave(uv.x, t) * 0.18))
    var sky = mix(vec3(0.02, 0.03, 0.10), vec3(0.05, 0.08, 0.22), uv.y)
    for i in 0..<3 {
      sky += vec3(0.01 * float(i))
    }
    if uv.x > 0.98 {
      return #000000
    } else if uv.x < 0.02 {
      sky = sky * 0.5
    } else {
      sky = sky * scale / scale
    }
    let color = vec3(tint.r, 0.5 + level * 0.5, tint.b)
    return vec4(sky + color * band * (0.7 + 0.3 * sin(time + uv.x * 4)), 1)
  }
}

component Sky {
  state level = 0.62

  Column {
    Aurora(level: level) {
      animated: true
      height: 140
      radius: 16
      clip: true
    }
    Text("level {level}")
    Slider { bind value: level }
  }
}

app { Sky() }

test "a shader is a view, its uniforms its parameters" {
  let app = mount(Sky())
  app.expect("level 0.62")
}
