import asuka/sensors
import asuka/time

component Tilt {
  state z = 0.0
  state status = ""
  task {
    do {
      for await a in sensors.accelerometer(every: 10ms) { z = a.z }
    } catch e {
      status = e.message
    }
  }
  Column {
    Text("z {z}")
    Text("status {status}")
  }
}

component Compass {
  state heading = 0.0
  state pitch = 0.0
  task {
    for await m in sensors.motion(every: 50ms) {
      heading = m.attitude.heading.rounded()
      pitch = (m.attitude.pitch * 180 / 3.141592653589793).rounded()
    }
  }
  Text("heading {heading} pitch {pitch}")
}

component Walk {
  state steps = 0
  task {
    for await s in sensors.stepUpdates() { steps = s.steps }
  }
  Text("{steps} steps")
}

app { Tilt() }

test "with no platform code, there are no sensors" {
  expect(!sensors.available(.motion))
  let app = mount(Tilt())
  await app.idle()
  app.expect("z 0")
  app.expect("status sensors: not available")
  do {
    let _ = try await sensors.steps(from: time.unix(0), to: time.unix(1))
  } catch sensors.SensorError.notAvailable {
    print("no steps")
  }
}

test "a fake's readings, as often as asked" {
  let f = sensors.fake()
  expect(sensors.available(.motion))
  let app = mount(Tilt())
  await app.idle()
  expect(f.watching(.accelerometer) == 1)
  f.accelerate(0, 0, 1)
  await app.idle()
  app.expect("z 1")
  // 5ms later: too soon for a stream that asked for every 10ms.
  f.tick = 5ms
  f.accelerate(0, 0, 0.5)
  await app.idle()
  app.expect("z 1")
  f.accelerate(0, 0, 0.25)
  await app.idle()
  app.expect("z 0.25")
}

test "attitude from gravity and the field" {
  let f = sensors.fake()
  let app = mount(Compass())
  await app.idle()
  // Face up, the top pointing north.
  f.move([0, 0, 1], field: [0, 20, -40])
  await app.idle()
  app.expect("heading 0 pitch 0")
  // Upright, the top up: pitch -90.
  f.tick = 100ms
  f.move([0, 1, 0], field: [-20, 0, -40])
  await app.idle()
  app.expect("heading 0 pitch -90")
  // As iOS's simulate takes it.
  try await sensors.simulate("\{\"kind\": 3, \"gravity\": [0, 0, -1], \"field\": [-20, 0, -40]}")
  await app.idle()
  app.expect("heading 90 pitch 0")
}

test "steps, and a sensor the device lacks" {
  let f = sensors.fake(present: [.pedometer])
  f.history = sensors.Steps(steps: 1200, distance: 900)
  expect((try await sensors.steps(from: time.unix(0), to: time.unix(1))).steps == 1200)
  let app = mount(Walk())
  await app.idle()
  f.walk(12)
  await app.idle()
  app.expect("12 steps")
  expect(!sensors.available(.gyroscope))
}
