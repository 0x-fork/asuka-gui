import asuka/dock
import asuka/platform

component Downloads {
  state p = 0.0

  Button("Step") {
    on press {
      p += 0.5
      dock.setProgress(dock.Progress(value: p))
      if p >= 1 { dock.requestAttention(.critical) }
    }
  }
}

app { Downloads() }

test "the dock's calls go to the host, which has no dock here" {
  let app = mount(Downloads())
  app.tap("Step")
  app.tap("Step")
  await app.idle()
  // A module the host doesn't have throws, for a call that waits.
  do {
    let _ = try await platform.call("dock", "progress", platform.u8(0))
    expect(false, "the fake host has no dock")
  } catch e {
    print("no dock: {e.message}")
  }
  print("after")
}

test "encodings" {
  let b = platform.u32(258).concat(platform.f64(1.5)).concat(platform.str("hé"))
  print(b.count())
  print(platform.readU32(b, 0))
  print(platform.readF64(b, 4))
  print(platform.readU32(b, 12))
  print(platform.readU8(b, 999))
}
