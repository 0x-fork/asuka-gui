// An array's map, filter, reduce, count(where:), any, all, find,
// index(where:) and compactMap with a closure, lowered as loops: each
// runs to its end before the next method, in the elements' order.

struct P {
  name: string
  age: int
}

fn main() {
  var order: [string] = []
  let xs = [3, 1, 4, 1, 5, 9, 2, 6]
  let ys = xs.map(x => { order.push("m{x}"); return x * 2 }).filter(x => { order.push("f{x}"); return x > 4 })
  print("{ys} {order}")
  print(xs.reduce(0, (s, x) => s + x))
  print(xs.count(where: x => x > 2))
  print(xs.any(where: x => x == 9))
  print(xs.any(where: x => x == 7))
  print(xs.all(where: x => x > 0))
  print(xs.all(where: x => x > 1))
  print(xs.find(where: x => x > 4))
  print(xs.find(where: x => x > 40))
  print(xs.index(where: x => x == 4))
  print(xs.index(where: x => x == 40))
  print(["1", "x", "3"].compactMap(s => s.toInt()))
  let people = [P(name: "al", age: 30), P(name: "bo", age: 17), P(name: "cy", age: 45)]
  print(people.filter(p => p.age >= 18).map(p => p.name))
  print(people.map(p => P(name: p.name.upper(), age: p.age + 1)))
  print(people.find(where: p => p.name == "bo"))
  print(people.compactMap(p => if p.age > 20 { p.name } else { none }))
  let empty: [int] = []
  print(empty.map(x => x + 1))
  print(empty.reduce(5, (s, x) => s + x))
  print([1.5, 2.0].map(x => x / 2.0))
  print([[1, 2], [3]].map(a => a.count()))
  var grid = [[1, 2], [3, 4]]
  let sums = grid.map(row => { grid.push([0]); return row.reduce(0, (s, x) => s + x) })
  print("{sums} {grid.count()}")
  let k = 10
  print(xs.map(x => x * k).filter(x => x % 20 == 0))
}
