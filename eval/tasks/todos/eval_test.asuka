test "eval: adds, completes and clears todos" {
  let app = mount(Todos())
  app.expect("0 left")
  app.tap("Add")
  app.expect("0 left")
  app.type("Milk", into: "New todo")
  app.tap("Add")
  app.type("Eggs", into: "New todo")
  app.tap("Add")
  app.expect("2 left")
  app.tap("Milk")
  app.expect("Done: Milk")
  app.expect("1 left")
  app.tap("Done: Milk")
  app.expect("2 left")
  app.tap("Milk")
  app.tap("Clear done")
  app.expectNo("Done: Milk")
  app.expect("Eggs")
  app.expect("1 left")
}
