test "eval: loads, holds while updating, and says when it fails" {
  let app = mount(Profile())
  app.expect("Loading")
  await app.idle()
  app.expect("User 1")
  app.expectNo("Updating")
  app.tap("Next")
  app.expect("User 1")
  app.expect("Updating")
  await app.idle()
  app.expect("User 2")
  app.expectNo("Updating")
  app.tap("Next")
  await app.idle()
  app.expect("Couldn't load")
  app.tap("Next")
  await app.idle()
  app.expect("User 4")
  app.expectNo("Couldn't load")
}
