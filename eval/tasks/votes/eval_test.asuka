test "eval: options, votes and the leader" {
  let app = mount(Poll())
  app.expect("No votes yet")
  app.type("Tea", into: "Option")
  app.tap("Add option")
  app.type("Coffee", into: "Option")
  app.tap("Add option")
  app.type("Tea", into: "Option")
  app.tap("Add option")
  app.expect("Tea: 0")
  app.expect("Coffee: 0")
  expect(app.texts().filter(t => t == "Tea: 0").count() == 1)
  app.expect("No votes yet")
  app.tap("Vote Coffee")
  app.expect("Coffee: 1")
  app.expect("Leading: Coffee")
  app.tap("Vote Tea")
  app.expect("Leading: Tea")
  app.tap("Vote Tea")
  app.expect("Tea: 2")
  app.expect("Leading: Tea")
}
