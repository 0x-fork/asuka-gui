// Web viewport is an e2e's app (e2e/webviewport_test.go): a WebView whose
// page posts how tall 100vh, 100dvh and 100% are, and its innerHeight,
// on a line the test reads.

/// The page: it measures the viewport's units with elements of those heights.
let page = """
  <!doctype html><meta name="viewport" content="width=device-width">
  <style>body\{margin:0} div\{position:absolute;top:0;width:1px}</style>
  <div id="vh" style="height:100vh"></div><div id="dvh" style="height:100dvh"></div>
  <script>
  function post() \{
    const h = id => Math.round(document.getElementById(id).getBoundingClientRect().height);
    window.asuka.postMessage("vh " + h("vh") + " dvh " + h("dvh") + " inner " + innerHeight);
  }
  addEventListener("load", post);
  addEventListener("resize", post);
  </script>
  """

component WebViewport {
  state measured = "none"

  Column {
    grow: 1
    Text("measured: {measured}") { padding: 16 }
    WebView {
      html: page
      on message(m) { measured = m }
    }
  }
}

app { WebViewport() }

test "nothing measured without a page" {
  let app = mount(WebViewport())
  app.expect("measured: none")
}
