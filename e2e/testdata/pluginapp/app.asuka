// Plugin app is the GUI tests' app of native packages: the greeter
// (e2e/testdata/greeter) and the pantry (internal/nativegen's testdata),
// each implemented on every platform. It calls their modules as it
// starts, and shows the greeter's view, which says what it shows.
import @asuka/greeter
import @asuka/pantry

component Plugin {
  state greeting = ""
  state stocked = ""
  state shown = "no badge"

  task {
    do {
      greeting = try greeter.Greeter().hello("Asuka")
    } catch e {
      greeting = "error: " + e.message
    }
    do {
      let p = try pantry.Pantry()
      let items = try p.items("salt")
      stocked = "pantry {try p.name()}: {items[0].name} {items[0].weight}g, {items[0].tags.count()} tags"
    } catch e {
      stocked = "error: " + e.message
    }
  }

  SafeArea {
    gap: 16
    padding: 24
    Text(greeting)
    Text(stocked)
    greeter.Badge("Asuka") {
      height: 32
      on shown(text) { shown = text }
    }
    Text("shown: {shown}")
  }
}

app { Plugin() }
