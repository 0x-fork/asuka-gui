// Greeter is a native package (asuka native): a module that says hello,
// and a view that says what it shows, each platform's own code
// implementing them (Swift on iOS and macOS, with a Swift package of its
// own, GreeterKit; Kotlin on Android, with a Maven dependency; JavaScript
// on the web; C on Windows and Linux). The GUI tests' plugin app
// (e2e/testdata/pluginapp) uses it on every platform.

/// Greets.
pub native interface Greeter {
  /// The platform's greeting to name.
  fn hello(name: string) -> string
}

/// A label showing a name; it says what it shows.
pub native component Badge {
  prop name: string = ""
  event shown(text: string)
}
