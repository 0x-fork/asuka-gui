// The notes and their database: what the Notes app and its notes
// command share.

import asuka/sqlite

pub struct Note {
  id: int
  text: string
  done: bool
}

/// The notes' database at path (in the app's directory: the app and
/// its command use the same one), made if it isn't there.
pub fn openDB(path: string) throws -> sqlite.DB {
  let db = try sqlite.open(path)
  try db.migrate([
    "create table notes (id integer primary key, text text not null, done bool not null default 0)",
  ])
  return db
}

/// The search's SQL: a match anywhere, any case; % and _ are text.
pub let search = "select * from notes where ?1 = '' or instr(lower(text), lower(?1)) > 0 order by done, id desc"
