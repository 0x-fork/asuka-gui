import platform/maps

let pins = [
  maps.Marker(id: "ferry", at: maps.Coordinate(lat: 37.7955, lng: -122.3937), title: "Ferry Building"),
  maps.Marker(id: "park", at: maps.Coordinate(lat: 37.7694, lng: -122.4862), title: "Golden Gate Park", color: #2e7d32),
]

screen MapScreen {
  state region = maps.Region(center: maps.Coordinate(lat: 37.7749, lng: -122.4194), latDelta: 0.08, lngDelta: 0.08)
  state picked = "Tap a pin"

  title: "Map"

  Column {
    grow: 1
    maps.View {
      bind region: region
      markers: pins
      grow: 1
      on markerPress(id) { picked = "Picked {id}" }
      on press(c) { picked = "{c.lat.fixed(4)}, {c.lng.fixed(4)}" }
      on error(m) { picked = m }
    }
    SafeArea {
      padding: 16
      Text(picked)
    }
  }
}
