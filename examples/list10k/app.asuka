// List10k shows 10,000 rows in a List: only the cells on screen have
// rows, and a recycled cell updates only the props that differ.
//
//   asuka dev --platform ios examples/list10k

struct Item {
  id: int
  title: string
  detail: string
  starred: bool = false
}

let words = ["amber", "basil", "cedar", "delta", "ember", "fjord", "garnet", "harbor", "indigo", "juniper"]

fn makeItems(n: int) -> [Item] = (0..<n).map(i => Item(
  id: i,
  title: "Row {i + 1}",
  detail: "{words[i % words.count]} {words[i / 10 % words.count]} · {i * 7 % 1000}",
))

component Rows {
  state items = makeItems(10_000)

  let starred = items.count(it => it.starred)

  SafeArea {
    Column {
      padding: [8, 16]
      gap: 2
      Text("10,000 rows") { font: .largeTitle.bold() }
      Text("{starred} starred · tap a row to star it") {
        font: .subheadline
        color: .secondaryLabel
      }
    }
    List {
      for item in items key item.id {
        Row {
          align: .center
          gap: 12
          padding: [10, 16]
          on press { items[item.id].starred = !item.starred }
          Column {
            grow: 1
            gap: 2
            Text(item.title) { font: .body }
            Text(item.detail) {
              font: .footnote
              color: .secondaryLabel
            }
          }
          Text(if item.starred { "★" } else { "☆" }) {
            font: .title3
            color: .orange
          }
        }
      }
    }
  }
}

app { Rows() }

test "a tapped row is starred" {
  let app = mount(Rows())
  app.expect("Row 1", "0 starred · tap a row to star it")
  app.tap("Row 1")
  app.expect("1 starred · tap a row to star it")
  app.tap("Row 1")
  app.expect("0 starred · tap a row to star it")
}
